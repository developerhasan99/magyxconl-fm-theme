        },
        "review_R6cFXG": {
          "type": "review",
          "settings": {
            "content": "<p>\"I've worn Creed Aventus for years, but this is the best dupe I've found — and for a fraction of the price. The combination of pineapple and vanilla is spot on.\"</p>",
            "author": "Alvarez P.",
            "date": "4 months ago",
