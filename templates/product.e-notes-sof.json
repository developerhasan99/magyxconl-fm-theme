        },
        "review_34h9By": {
          "type": "review",
          "settings": {
            "content": "<p>\"I'm happy with MagyX. The scent closely resembles the original and lasts well. The packaging is neat and the bottle looks nice. All in all a great option if you want a quality fragrance at a reasonable price.\"</p>",
            "author": "Alina M",
