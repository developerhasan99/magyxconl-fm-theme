            "rating": 5,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_eDgrQy": {
          "type": "review",
          "settings": {
            "content": "<p>\"Great product! Super affordable alternative to brand-name perfumes. The scent lasts a long time and you get great value for money\"</p>",
            "author": "EM",
            "date": "4 months ago",
