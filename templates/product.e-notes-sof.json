          }
        },
        "review_KeHBHM": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h58_13.png",
            "content": "<p>\"This is the kind of scent that makes you feel put together. Not overwhelming, just right. 👌\"</p>",
            "author": "Michael R.",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "alpha-oil"
