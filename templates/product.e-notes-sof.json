        },
        "review_jBfaqJ": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Anastasiia_Komisarova.jpg",
            "content": "<p>\"Beautiful scent. Long-lasting. <br/>Sweet and warm. Fast delivery. <br/>Will definitely order again.\"</p>",
            "author": "Lucy R",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "6x-30ml-perfume-bottles"
