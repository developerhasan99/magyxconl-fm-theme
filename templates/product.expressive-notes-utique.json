        "custom_liquid": "<style>\n#mp-reviews-custom{padding:48px 0;background:#fff;overflow:hidden}\n#mp-reviews-custom .mp-container{width:min(860px,calc(100% - 36px));margin-inline:auto}\n#mp-reviews-custom .mp-head{text-align:center;max-width:640px;margin:0 auto 30px}\n#mp-reviews-custom .mp-stars-lg,#mp-reviews-custom .mp-stars{display:flex;gap:3px}\n#mp-reviews-custom .mp-stars-lg{justify-content:center;margin-bottom:14px}\n#mp-reviews-custom .mp-stars-lg span,#mp-reviews-custom .mp-stars span{display:grid;place-items:center;background:#00b67a}\n#mp-reviews-custom .mp-stars-lg span{width:28px;height:28px}\n#mp-reviews-custom .mp-stars-lg .mp-partial{background:linear-gradient(90deg,#00b67a 0 70%,#dcdce6 70% 100%)}\n#mp-reviews-custom .mp-stars span{width:15px;height:15px}\n#mp-reviews-custom svg{fill:#fff;width:76%;height:76%}\n#mp-reviews-custom .mp-title{margin:0 0 10px;font-size:26px;line-height:1.25;font-weight:800;color:#121212}\n#mp-reviews-custom .mp-sub{margin:0;font-size:14px;line-height:1.5;color:rgba(0,0,0,.62)}\n#mp-reviews-custom .mp-carousel{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 8px}\n#mp-reviews-custom .mp-carousel::-webkit-scrollbar{display:none}\n#mp-reviews-custom .mp-card{flex:0 0 calc((100% - 32px) / 3);scroll-snap-align:start;box-sizing:border-box;display:flex;flex-direction:column;background:#fff;border:1px solid #e8e8e8;border-radius:10px;padding:16px 16px 14px;box-shadow:0 1px 4px rgba(0,0,0,.05)}\n#mp-reviews-custom .mp-card-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}\n#mp-reviews-custom .mp-verified{font-size:11px;color:rgba(0,0,0,.55);white-space:nowrap}\n#mp-reviews-custom .mp-card h3{margin:0 0 8px;font-size:14px;line-height:1.4;font-weight:700;color:#121212}\n#mp-reviews-custom .mp-card p{margin:0 0 8px;font-size:13px;line-height:1.6;color:rgba(0,0,0,.62)}\n#mp-reviews-custom .mp-card .mp-result{font-weight:600;color:#121212;margin-bottom:12px}\n#mp-reviews-custom .mp-card-foot{margin-top:auto;font-size:13px;color:#121212}\n#mp-reviews-custom .mp-nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px}\n#mp-reviews-custom .mp-arrow{width:40px;height:40px;border-radius:50%;border:1px solid #d6d6d6;background:#fff;color:#121212;font-size:22px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 3px;transition:background .2s,color .2s,border-color .2s}\n#mp-reviews-custom .mp-arrow:hover{background:#121212;border-color:#121212;color:#fff}\n#mp-reviews-custom .mp-arrow:disabled{opacity:.35;cursor:default;background:#fff;color:#121212;border-color:#d6d6d6}\n#mp-reviews-custom .mp-dots{display:flex;gap:0}\n#mp-reviews-custom .mp-dot{box-sizing:content-box;width:8px;height:8px;border-radius:50%;border:0;padding:8px 5px;background:#d9d9d9;background-clip:content-box;cursor:pointer}\n#mp-reviews-custom .mp-dot.active{background:#00b67a}\n@media(max-width:749px){\n  #mp-reviews-custom{padding:32px 0}\n  #mp-reviews-custom .mp-container{width:100%}\n  #mp-reviews-custom .mp-head{padding:0 18px;margin-bottom:22px}\n  #mp-reviews-custom .mp-stars-lg span{width:24px;height:24px}\n  #mp-reviews-custom .mp-title{font-size:22px}\n  #mp-reviews-custom .mp-carousel{gap:12px;padding:4px 18px 8px;scroll-padding-left:18px}\n  #mp-reviews-custom .mp-card{flex-basis:82%}\n  #mp-reviews-custom .mp-arrow{display:none}\n}\n</style>\n\n<section id=\"mp-reviews-custom\" data-review-label=\"{{ 'aaroma.reviews.review_n' | t | escape }}\">\n  <div class=\"mp-container\">\n    <div class=\"mp-head\">\n      <div class=\"mp-stars-lg\" role=\"img\" aria-label=\"{{ 'aaroma.reviews.stars_total' | t | escape }}\">\n        <span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span>\n        <span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6