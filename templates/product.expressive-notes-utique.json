     var d = document.createElement('button');\n      d.type = 'button';\n      d.className = 'mp-dot';\n      d.setAttribute('aria-label', (root.getAttribute('data-review-label') || '').replace('__N__', i + 1));\n      d.addEventListener('click', go.bind(null, i));\n      dotsWrap.appendChild(d);\n    }\n    update();\n  }\n\n  function update(){\n    var c = current(), n = positions();\n    Array.prototype.forEach.call(dotsWrap.children, function(d, i){\n      d.classList.toggle('active', i === c);\n    });\n    prev.disabled = c <= 0;\n    next.disabled = c >= n - 1;\n  }\n\n  prev.addEventListener('click', function(){\n    go(Math.max(0, current() - 1));\n  });\n\n  next.addEventListener('click', function(){\n    go(Math.min(positions() - 1, current() + 1));\n  });\n\n  var t;\n  track.addEventListener('scroll', function(){\n    clearTimeout(t);\n    t = setTimeout(update, 60);\n  });\n\n  window.addEventListener('resize', buildDots);\n  buildDots();\n})();\n</script>",
