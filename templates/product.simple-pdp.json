        },
        "review_BaNdAM": {
          "type": "review",
          "settings": {
            "content": "<p>\"One of my favorite scents. Arrived quickly. Smells so good.\"</p>",
            "author": "Alex W.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_nqKqMa": {
          "type": "review",
          "settings": {
