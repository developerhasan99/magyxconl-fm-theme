    "massive_review_bRbA9R": {
      "type": "massive-review",
      "blocks": {
        "review_8gHPQW": {
          "type": "review",
          "settings": {
            "content": "<p>\"This is my first purchase and I'm addicted. I'll never buy perfume anywhere else. I could never find a dupe scent that smelled truly authentic and consistent.\"</p>",
            "author": "Killian P.",
            "date": "1 day ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamot-sage-cedar-50-ml"
          }
        },
        "review_UtKFTG": {
          "type": "review",
          "settings": {
            "content": "<p>\"This is the best perfume I've smelled in a very long time. The notes make me crazy with joy. I'll keep this in my rotation forever.\"</p>",
            "author": "Jenniffer W.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "4x-50ml-perfume-bottles"
          }
        },
        "review_GMPkF8": {
          "type": "review",
          "settings": {
            "content": "<p>\"All three scents I received are very good. They last a long time and smell the way they should. My only disappointment was how long it took to receive them. But honestly, I placed a second order, so just expect a wait. Lol!<br/>\"</p>",
            "author": "Clara P.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "apple-cinnamon-sandalwood"
          }
        },
        "review_g43cRA": {
          "type": "review",
          "settings": {
            "content": "<p>\"I'd been trying for a long time to find scents that smell expensive and last a long time, but in vain. This is exactly what I was looking for.\"</p>",
            "author": "Tiana N.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "fresh-escape-premium"
          }
        },
        "review_yQfnHP": {
          "type": "review",
          "settings": {
            "content": "<p>\"I didn't know what to expect, but this really surprised me. Smells super fresh and honestly very close to Aventus. It lasts well and the price is much better.\"</p>",
            "author": "Michael T.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "pineapple-smoke-vanilla-50-ml-1-7-fl-oz"
