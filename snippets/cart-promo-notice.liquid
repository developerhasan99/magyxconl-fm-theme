{%- comment -%} Cart drawer notice: free UTIQUE sample with every order. Remove the render in cart-drawer.liquid to take it down. {%- endcomment -%}
{%- case request.locale.iso_code -%}
  {%- when 'pl' -%}{%- assign tpn_title = 'Darmowa próbka UTIQUE do każdego zamówienia' -%}
  {%- when 'cs' -%}{%- assign tpn_title = 'Vzorek UTIQUE zdarma ke každé objednávce' -%}
  {%- when 'de' -%}{%- assign tpn_title = 'Gratis UTIQUE-Probe zu jeder Bestellung' -%}
  {%- when 'nl' -%}{%- assign tpn_title = 'Gratis UTIQUE-proefje bij elke bestelling' -%}
  {%- when 'fr' -%}{%- assign tpn_title = 'Échantillon UTIQUE offert avec chaque commande' -%}
  {%- when 'it' -%}{%- assign tpn_title = 'Campioncino UTIQUE in omaggio con ogni ordine' -%}
  {%- when 'es' -%}{%- assign tpn_title = 'Muestra de UTIQUE gratis con cada pedido' -%}
  {%- when 'pt-PT', 'pt' -%}{%- assign tpn_title = 'Amostra UTIQUE grátis em cada encomenda' -%}
  {%- when 'sv' -%}{%- assign tpn_title = 'Gratis UTIQUE-prov med varje beställning' -%}
  {%- when 'da' -%}{%- assign tpn_title = 'Gratis UTIQUE-prøve med hver ordre' -%}
  {%- when 'fi' -%}{%- assign tpn_title = 'Ilmainen UTIQUE-näyte jokaisen tilauksen mukana' -%}
  {%- else -%}{%- assign tpn_title = 'Free UTIQUE sample with every order' -%}
{%- endcase -%}
<div class="ts-promo-notice" role="note">
  <svg class="ts-promo-notice__icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <circle cx="10" cy="10" r="8.5" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <rect x="9.1" y="5" width="1.8" height="6.5" rx="0.9" fill="currentColor"/>
    <circle cx="10" cy="14.4" r="1.1" fill="currentColor"/>
  </svg>
  <p class="ts-promo-notice__title">{{ tpn_title }}</p>
</div>
<style>
  .ts-promo-notice { display: flex; gap: 12px; align-items: center; margin: 12px 0; padding: 12px 14px; border: 1px dashed #e0484f; border-radius: 6px; background: #fff3f3; text-align: left; }
  .ts-promo-notice .ts-promo-notice__icon { flex: 0 0 20px; color: #e0484f; }
  .ts-promo-notice .ts-promo-notice__title { margin: 0; font-size: 14px; line-height: 1.3; font-weight: 700; text-transform: uppercase; letter-spacing: 0; color: #e0484f; }
</style>
