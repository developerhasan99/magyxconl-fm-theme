{%- comment -%}
  fmx-bundle-builder (aaroma.co, FM look): copy of aaroma's snippets/special-offer-builder.liquid (the bundle slot
  builder: Alpine store bundleBuilder, picker modal snippets/special-offer-products-modal.liquid, cart properties,
  checkout) in the layout of magicperfume.co snippets/fmx-bundle-builder.liquid:
  price row (struck regular price, price, -N% tag, price per bottle, "You save ... today" pill) -> steps bar
  (thin ink progress line + "n / N selected · hint") -> FM bottle slots -> FM ink buy button -> payment icons +
  badge row (in place of the "Shipped within 48 hours" line). The short description + "Read more" and the claim
  lines above it are the cheaper_than and selling_points blocks of sections/fmx-main-product.liquid.
  Builder logic and cart line properties ("Bottle n" / "Inspired by", as live) unchanged. Texts = locale keys.
  Styles: assets/fmx-pdp.css (B2 - B4). Rendered by fmx-main-product (atc_bundle_builder block, bundle products).
  Generated by docs/pdp-parity/build_fmx_bundle_builder.py from special-offer-builder.liquid; re-run, don't hand-edit.
{%- endcomment -%}
{% assign bundle_collection_handles = 'top-sellers,heetste-zomergeuren-2026' | split: ',' %}
{% assign new_arrival_collection_handle = 'heetste-zomergeuren-2026' %}
{% assign product_count = product.metafields.custom.choose_your_fragrances_options %}
{% assign dropdown_ml = product.metafields.custom.select_bundle_dropdown_ml | default: "50" %}
{% assign bundle_ml = dropdown_ml | append: "ml" %}
{% assign bundle_size_token = dropdown_ml | append: '' | downcase | strip | replace: ' ', '' | remove: 'ml' | append: 'ml' %}
{% assign selected_variant = product.selected_or_first_available_variant %}
{% assign fixed_bundle_products = product.metafields.custom.fixed_bundle_products.value %}

{%- comment -%} Price row (magicperfume.co FM bundle buy box; data = this product's price / compare-at). {%- endcomment -%}
{% if product.tags contains 'Bundle_Price_Show' %}
  <div
    id="price-{{ section.id }}"
    class="bundle-price-pdp"
    role="status"
    {{ block.shopify_attributes }}>
    <div class="flex flex-wrap items-center gap-x-3">
      {% if product.compare_at_price > product.price %}
        <s class="mgx-bundle-compare compare-price">{{ product.compare_at_price | money }}</s>
      {% endif %}
      <span class="mgx-bundle-price product-price">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        {% assign discount = product.compare_at_price | minus: product.price %}
        {% assign discount_percent = discount | times: 100 | divided_by: product.compare_at_price | round %}
        <span class="discount-percent">-{{ discount_percent }}%</span>
      {% endif %}
    </div>
    {%- assign per_bottle_money = product.price | times: 1.0 | divided_by: product_count | round | money -%}
    <div class="text-lg">{{ 'aaroma.pdp.only_per_bottle_slash' | t: price: per_bottle_money }}</div>
    {% if product.compare_at_price > product.price %}
      {%- assign you_save_money = product.compare_at_price | minus: product.price | money -%}
      <div class="fmx-save-pill">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z"></path></svg>
        {{ 'premium.pdp.you_save_today' | t: amount: you_save_money }}
      </div>
    {% endif %}
  </div>
{% endif %}

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>

{%- liquid
  assign next_bundle = product.metafields.custom.next_bundle
  if next_bundle != blank
    assign next_bundle_product = next_bundle.value
    assign next_size = next_bundle_product.metafields.custom.select_bundle_dropdown_ml
    assign price_difference = next_bundle_product.price | minus: product.price | money
  endif
-%}

{% if next_bundle != blank %}
  <div class="fmx-upgrade bg-white border border-gray-200 rounded-lg px-4 py-2.5 mb-4">
    <div class="flex items-center gap-2 text-black">
      <svg
        class="size-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
      </svg>
      <span>{{ 'aaroma.bundle.upgrade_to' | t }}
        <a href="{{ next_bundle_product.url }}" class="ml-auto font-medium fmx-upgrade__link whitespace-nowrap transition-colors">
          {{ 'aaroma.bundle.upgrade_more' | t: size: next_size, price: price_difference }}</a>
      </span>
    </div>
  </div>
{% endif %}

{%- comment -%}
  Steps bar = magicperfume.co / tryscent.co FM steps (thin ink progress line + "[selected] / [total] selected · hint"),
  driven by the Alpine store bundleBuilder (selectedProducts). Fixed bundles (no picking) show none.
{%- endcomment -%}
{%- unless product.tags contains 'fixed_bundle' -%}
  {%- capture fmx_count_label -%}{{ 'premium.bundle.selected_count' | t: count: '__C__', total: product_count }}{%- endcapture -%}
  <div class="fmx-steps" x-data>
    <div class="fmx-steps__track" role="progressbar" aria-valuemin="0" aria-valuemax="{{ product_count }}" :aria-valuenow="$store.bundleBuilder.selectedProducts.length">
      <div class="fmx-steps__fill" :style="'width:' + Math.min(100, $store.bundleBuilder.selectedProducts.length / {{ product_count }} * 100) + '%'"></div>
    </div>
    <p class="fmx-steps__label">
      <span x-text="{{ fmx_count_label | json | escape }}.replace('__C__', $store.bundleBuilder.selectedProducts.length)">{{ fmx_count_label | replace: '__C__', '0' }}</span>
      <span class="fmx-steps__dot" aria-hidden="true">·</span>
      <span x-text="({{ product_count }} - $store.bundleBuilder.selectedProducts.length) <= 0 ? {{ 'aaroma.bundle.ready' | t | json | escape }} : (({{ product_count }} - $store.bundleBuilder.selectedProducts.length) === 1 ? {{ 'aaroma.bundle.select_n_one' | t | json | escape }} : {{ 'aaroma.bundle.select_n_other' | t: count: '__N__' | json | escape }}.replace('__N__', {{ product_count }} - $store.bundleBuilder.selectedProducts.length))">{{ 'aaroma.bundle.select_n_other' | t: count: product_count }}</span>
    </p>
  </div>
{%- endunless -%}

<div x-data>
  <div class="grid grid-cols-1 gap-2 mb-4">
    <template x-for="index in ({{ product_count }})" :key="index">
      <div
        {% unless product.tags contains 'fixed_bundle' %}
          @click="$store.bundleBuilder.showModal = true"
        {% endunless %}
        class="fmx-slot bg-white border-2 border-solid border-gray-200 flex items-center p-[7px] rounded-xl gap-2 cursor-pointer relative transition duration-300"
        :class="{ 'fmx-slot--filled' : typeof $store.bundleBuilder.selectedProducts[index - 1] !== 'undefined'}">
        <div x-text="index" class="fmx-slot__num size-6 text-white font-bold text-xs flex items-center justify-center shrink-0"></div>
        <div x-show="!$store.bundleBuilder.selectedProducts[index - 1]" class="flex min-w-0 gap-2 items-center flex-grow">
            {% render 'perfume-icon'
            , size: 40 %}
            <div class="min-w-0 flex-1">
              <div class="text-sm text-[#6b7280] overflow-hidden whitespace-nowrap [text-overflow:ellipsis]">{{ 'aaroma.bundle.choose_fragrance' | t }}</div>
            </div>
            <span class="ml-auto shrink-0 text-[#6b7280]"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg></span>
        </div>
        <div x-show="$store.bundleBuilder.selectedProducts[index - 1]" class="flex min-w-0 gap-2 items-center flex-grow">
            <img
                class="object-cover rounded"
                :src="$store.bundleBuilder.selectedProducts[index - 1]?.image"
                :alt="$store.bundleBuilder.selectedProducts[index - 1]?.name"
                width="40"
                height="40"
            >
            <div class="text-left min-w-0 flex-1 flex flex-col gap-1">
                <div class="font-bold text-sm leading-tight text-black line-clamp-1" x-text="$store.bundleBuilder.selectedProducts[index - 1]?.name"></div>
                <div class="text-xs line-clamp-1 text-[#6b7280]"><span x-text="$store.bundleBuilder.selectedProducts[index - 1]?.inspiration_name"></span> - <span x-text="$store.bundleBuilder.selectedProducts[index - 1]?.variant?.title"></span></div>
            </div>
            {% unless product.tags contains 'fixed_bundle' %}
              <button @click.stop.prevent="$store.bundleBuilder.removeProduct(index - 1)" class="ml-auto size-7 shrink-0 bg-red-50 flex items-center justify-center rounded text-xs cursor-pointer border-0">
                  {% render 'icon-trash' %}
              </button>
            {% else %}
            {% endunless %}
        </div>
      </div>
    </template>
  </div>

  <button
    x-data
    @click="$store.bundleBuilder.doATCandCheckout()"
    :disabled="$store.bundleBuilder.selectedProducts.length < {{ product_count }} || $store.bundleBuilder.addingToCart"
    :class="{
        'opacity-50 cursor-not-allowed': $store.bundleBuilder.selectedProducts.length < {{ product_count }},
        'cursor-pointer': $store.bundleBuilder.selectedProducts.length >= {{ product_count }}
      }"
    class="fmx-bundle-atc w-full flex gap-2 flex-wrap items-center !mb-0 text-lg font-bold !py-3 !px-2 rounded-full button mgx-btn-primary transition-colors tracking-normal button--full-width"
  >
    <span x-show="$store.bundleBuilder.selectedProducts.length < {{ product_count }}" x-text="{{ 'aaroma.bundle.select_more_btn' | t: count: '__N__' | json | escape }}.replace('__N__', {{ product_count }} - $store.bundleBuilder.selectedProducts.length)"></span>
    <span x-show="$store.bundleBuilder.selectedProducts.length === {{ product_count }}">{{ 'aaroma.bundle.buy_now' | t }}</span>
    <span class="size-2 rounded-full inline-block bg-white/50"></span>
    <span class="current-price">{{ selected_variant.price | money }}</span>
    <div x-show="$store.bundleBuilder.addingToCart" class="loading__spinner">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="spinner"
        viewBox="0 0 66 66">
        <circle
          stroke-width="6"
          cx="33"
          cy="33"
          r="30"
          fill="none"
          class="path"></circle>
      </svg>
    </div>
  </button>
  <p x-data x-show="$store.bundleBuilder.cartError" x-text="$store.bundleBuilder.cartError"
     role="alert" aria-live="assertive" class="!mt-2 !mb-0 text-sm text-center text-red-600"></p>
  {% render 'gift-wrap', pdp: true %}
</div>

<div class="fmx-trust">
  {% render 'fmx-payment-icons' %}
  {% render 'fmx-shipping-badges', product: product %}
</div>

<script>
  document.addEventListener('alpine:init', function() {
    Alpine.store('bundleBuilder', {
      selectedVariant: {{ bundle_size_token | json }},
      bundleLength: {{ product_count }},
      showModal: false,
      activeCategory: "All",
      searchText: "",
      addingToCart: false,
      cartError: '',
      selectedProducts: [
        {% if product.tags contains 'fixed_bundle' %}
          {% for fixed_var in fixed_bundle_products %}
            {
              id: {{ fixed_var.product.id }},
              name: "{{ fixed_var.product.title }}",
              image: "{{ fixed_var.product.featured_image | image_url }}",
              inspiration_name: "{% if fixed_var.product.metafields.custom.inspiration.value %}{{ fixed_var.product.metafields.custom.inspiration.value.name }}{% endif %}",
              variant: {
                id: "{{ fixed_var.id }}",
                title: "{{ fixed_var.title }}"
              }
            },
          {% endfor %}
        {% endif %}
      ],
      availableProducts: [
        {% for bundle_collection_handle in bundle_collection_handles %}
          {% assign bundle_collection = collections[bundle_collection_handle] %}
          {% paginate bundle_collection.products by 250 %}
            {% for bundle_product in bundle_collection.products %}
              {% liquid
                assign bundle_variant = nil
                for variant in bundle_product.variants
                  assign variant_token = variant.title | downcase | strip | replace: ' ', ''
                  if variant_token == bundle_size_token
                    assign bundle_variant = variant
                    break
                  endif
                endfor
                if bundle_variant == blank or bundle_variant.available == false
                  continue
                endif
                if bundle_variant.inventory_management == 'shopify' and bundle_variant.inventory_quantity < 1
                  continue
                endif

                assign collection_handles = ''
                for collection in bundle_product.collections
                  assign collection_handles = collection_handles | append: collection.handle
                  if forloop.last == false
                    assign collection_handles = collection_handles | append: ','
                  endif
                endfor
              %}
              {
                id: {{ bundle_product.id }},
                name: {{ bundle_product.title | json }},
                image: "{{ bundle_product.featured_image | image_url: width: 120, height: 120 }}",
                nuta: {{ bundle_product.metafields.custom.inspiration.value.name | default: '' | json }},
                inspiration_image: "{% if bundle_product.metafields.custom.inspiration.value %}{{ bundle_product.metafields.custom.inspiration.value.image | image_url: width: 90, height: 90 }}{% endif %}",
                inspiration_name: {{ bundle_product.metafields.custom.inspiration.value.name | default: '' | json }},
                occasion: {{ bundle_product.metafields.custom.occasion.value | default: '' | strip_newlines | json }},
                tags: {{ bundle_product.tags | json }},
                collections: "{{ collection_handles }}",
                isNewArrival: {% if bundle_collection_handle == new_arrival_collection_handle %}true{% else %}false{% endif %},
                variants: {
                  {{ bundle_size_token | json }}: {
                    title: {{ bundle_variant.title | json }},
                    id: "{{ bundle_variant.id }}"
                  }
                }
              },
            {% endfor %}
          {% endpaginate %}
        {% endfor %}
      ].reduce((products, product) => {
        const existing = products.find(item => item.id === product.id);
        if (existing) {
          existing.isNewArrival = existing.isNewArrival || product.isNewArrival;
        } else {
          products.push(product);
        }
        return products;
      }, []),
      productInCollection(product, handle) {
        return (product.collections || '').split(',').includes(handle);
      },
      matchesProduct(product) {
        const categoryMatches = this.activeCategory === 'All'
          ? true
          : this.activeCategory === 'New Arrivals'
            ? product.isNewArrival
            : product.tags.some(tag => tag === this.activeCategory);
        const search = this.searchText.trim().toLowerCase();
        return categoryMatches && (search === '' || product.name.toLowerCase().includes(search) || (product.inspiration_name || '').toLowerCase().includes(search));
      },
      addProduct(product) {
        if (this.selectedProducts.length >= {{ product_count }}) return;
        product.variant = product.variants[this.selectedVariant]
        this.selectedProducts.push(product);

        if (this.selectedProducts.length === {{ product_count }}) {
          this.showModal = false;
          {% if block.settings.skip_atc_button %}
            this.doATCandCheckout();
          {% endif %}
        }
      },
      removeOne(productId) {
        const index = this.selectedProducts.findLastIndex(item => item.id === productId);
        if (index > -1) this.removeProduct(index);
      },
      removeProduct(index) {
        this.selectedProducts.splice(index, 1);
      },
      productCount(productId) {
        return this.selectedProducts.filter(product => product.id === productId).length;
      },
      isProductSelected(productId) {
        return this.selectedProducts.some(product => product.id === productId);
      },
      doATCandCheckout() {
        // Set loading state
        this.addingToCart = true;
        this.cartError = '';

        // Fall back to the bundle-size variant for products added without one (e.g. quiz prefill)
        this.selectedProducts.forEach(product => {
          product.variant = product.variant || product.variants[this.selectedVariant];
        });

        // Create properties object with bundle items
        const properties = {
          "_bundle_items": this.selectedProducts.map(product => 
            product.variant.id
          ).join(',')
        };
        // Add each selected product as a separate property
        this.selectedProducts.forEach((product, index) => {
          properties[`Bottle ${index + 1}`] =
            `${product.name} Inspired by ${product.inspiration_name} - ${product.variant.title}`;
        });
        // Prepare cart items
        const items = {
          items: [{
            id: {{ selected_variant.id }},
            quantity: 1,
            properties: properties
          }]
        };
        const openCheckout = {{ block.settings.open_checkout | json }};
        const cart = document.querySelector('cart-drawer');
        if (cart && !openCheckout) {
          items.sections = cart.getSectionsToRender().map(s => s.id);
          items.sections_url = cartSectionsUrl();
        }

        // Make the API call
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(items),
        })
        .then(async response => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok || data.status) {
            const error = new Error(data.description || data.message || `Request failed with status ${response.status}`);
            error.response = data;
            throw error;
          }
          return data;
        })
        .then(data => {
          {% unless product.tags contains 'fixed_bundle' %}
            this.selectedProducts = [];
          {% endunless %}
          // Custom add: no product-form event, so add a ticked gift wrap here (assets/gift-wrap.js).
          const giftWrap = document.querySelector('gift-wrap-pdp');
          if (openCheckout) {
            return Promise.resolve(giftWrap && giftWrap.afterAdd()).then(() => { window.location.href = '/checkout'; });
          } else if (!cart) {
            window.location.href = '/cart';
          } else {
            // global.js: on a translated page the drawer comes back through the page's own path.
            return cartTranslateSections(data.sections, items.sections).then(sections => {
              data.sections = sections;
              cart.classList.remove('is-empty');
              cart.renderContents(data);
              if (giftWrap) giftWrap.afterAdd();
            });
          }
        })
        .catch(error => {
          console.error('Error adding to cart:', error, error.response || '');
          const data = error.response || {};
          this.cartError = data.description || data.message || {{ 'sections.cart.cart_error' | t | json }};
        })
        .finally(() => {
          this.addingToCart = false;
        });
      }
    });
  });
</script>
