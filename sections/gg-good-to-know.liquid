{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-gtk" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap">
    {%- if section.settings.heading != blank -%}
      <div class="gg-head gg-head--center">
        <h2 class="gg-h2">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="gg-gtk__grid">
        {%- for block in section.blocks -%}
          <li class="gg-gtk__item" {{ block.shopify_attributes }}>
            <h3 class="gg-h3 gg-gtk__title">{{ block.settings.title | escape }}</h3>
            <div class="gg-gtk__text">{{ block.settings.text }}</div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Good to know",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good to know before you order"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Good to know",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Ready to give",
            "text": "<p>Every bottle is boxed on its own. All that's left is the wrapping.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Not a fit?",
            "text": "<p>60-day money-back guarantee.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
