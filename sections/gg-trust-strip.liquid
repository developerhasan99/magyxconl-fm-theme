{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-trust gg--surface" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="gg-trust__viewport">
      <div class="gg-trust__track" style="--gg-trust-speed: {{ section.settings.speed }}s">
        {%- for i in (1..3) -%}
          <ul class="gg-trust__group"{% if i > 1 %} aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <li class="gg-trust__item"{% if i == 1 %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "GG Trust strip",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (optional)"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duration per loop",
      "min": 15,
      "max": 90,
      "step": 5,
      "unit": "s",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Lasts over 12 hours"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Trust strip",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "20% perfume oil"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Lasts over 12 hours"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Every bottle boxed on its own, ready to give"
          }
        }
      ]
    }
  ]
}
{% endschema %}
