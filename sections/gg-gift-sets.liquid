{%- comment -%}
  gg-gift-sets: Gift Guide row of ready-made gift sets ("For her", "For him", ...).
  Blocks:
    - gift_set:   one gift-set card (snippets/gg-gift-card.liquid), product = bundle with custom.fixed_bundle_products
    - discovery:  grid tile "Discovery set" (same height as the cards); without a product it is a placeholder without link
    - build_tile: full-width tile under the cards (outside the mobile carousel) linking to the builder section
  Mobile: cards + discovery tile = snap carousel (.gg-row, 85%); desktop: grid of 2 or 3 columns, or with
  "carousel" on a scrolling row of that many visible cards with prev/next arrows (<gg-carousel>, assets/gg-card.js).
  Card strings are section settings so each row can be worded on its own.
{%- endcomment -%}
{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-card.css' | asset_url | stylesheet_tag }}
<script>window.ggMoneyFormat = window.ggMoneyFormat || {{ shop.money_format | json }};</script>
<script src="{{ 'gg-core.js' | asset_url }}" defer></script>
<script src="{{ 'gg-card.js' | asset_url }}" defer></script>

{%- liquid
  assign gs = section.settings
  assign gs_bg = ''
  case gs.background
    when 'surface'
      assign gs_bg = ' gg--surface'
    when 'surface-2'
      assign gs_bg = ' gg--surface-2'
  endcase
  assign gs_cols = gs.columns | default: '3'
  if gs.container == 'narrow'
    assign gs_wrap = 'gg__wrap gg__wrap--narrow'
    assign gs_sizes = '(min-width: 990px) 410px, (min-width: 750px) 46vw, 85vw'
  else
    assign gs_wrap = 'gg__wrap'
    if gs_cols == '2'
      assign gs_sizes = '(min-width: 1360px) 640px, (min-width: 990px) calc((100vw - 88px) / 2), (min-width: 750px) 46vw, 85vw'
    else
      assign gs_sizes = '(min-width: 1360px) 420px, (min-width: 990px) calc((100vw - 112px) / 3), (min-width: 750px) 46vw, 85vw'
    endif
  endif
  assign gs_anchor = gs.anchor | handleize
  assign gs_row_count = 0
  for block in section.blocks
    if block.type == 'discovery'
      assign gs_row_count = gs_row_count | plus: 1
    elsif block.type == 'gift_set'
      if block.settings.product != blank or request.design_mode
        assign gs_row_count = gs_row_count | plus: 1
      endif
    endif
  endfor
-%}

{%- style -%}
  @media screen and (min-width: 990px) {
    #gg-{{ section.id }} {
      --gg-pad-top: {{ gs.padding_top }}px;
      --gg-pad-bottom: {{ gs.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="gg gg-sets{{ gs_bg }}" id="gg-{{ section.id }}">
  {%- if gs_anchor != blank -%}
    <span class="gg-anchor" id="{{ gs_anchor }}">&#8203;</span>
  {%- endif -%}
  <div class="{{ gs_wrap }}">
    {%- if gs.eyebrow != blank or gs.heading != blank or gs.text != blank -%}
      <div class="gg-head">
        {%- if gs.eyebrow != blank -%}
          <span class="gg-eyebrow">{{ gs.eyebrow | escape }}</span>
        {%- endif -%}
        {%- if gs.heading != blank -%}
          <h2 class="gg-h2">{{ gs.heading | escape }}</h2>
        {%- endif -%}
        {%- if gs.text != blank -%}
          <p class="gg-sub">{{ gs.text }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if gs_row_count > 0 -%}
      {%- if gs.carousel -%}<gg-carousel class="gg-carousel">{%- endif -%}
      <div class="gg-row gg-sets__grid{% if gs.carousel %} gg-row--carousel{% endif %}" style="--gg-cols: {{ gs_cols }};"{% if gs.carousel %} data-gg-track tabindex="0" role="region" aria-label="{{ gs.heading | escape }}"{% endif %}>
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'gift_set' -%}
              {%- if block.settings.product != blank or request.design_mode -%}
                <div class="gg-sets__item" {{ block.shopify_attributes }}>
                  {%- render 'gg-gift-card',
                    product: block.settings.product,
                    badge_text: gs.badge_text,
                    atc_label: gs.atc_label,
                    soldout_label: gs.soldout_label,
                    boxed_line: gs.boxed_line,
                    contents_heading: gs.contents_heading,
                    details_label: gs.details_label,
                    swap_label: gs.swap_label,
                    inspired_word: gs.inspired_word,
                    number_label: gs.number_label,
                    error_label: gs.error_label,
                    added_label: gs.added_label,
                    show_swap: gs.show_swap,
                    swap_max: gs.swap_max,
                    choose_label: gs.choose_label,
                    img_sizes: gs_sizes
                  -%}
                </div>
              {%- endif -%}
            {%- when 'discovery' -%}
              {%- assign gd = block.settings -%}
              <div class="gg-sets__item" {{ block.shopify_attributes }}>
                <div class="gg-disc{% if gd.product == blank %} gg-disc--soon{% endif %}">
                  {%- if gd.eyebrow != blank -%}
                    <span class="gg-eyebrow">{{ gd.eyebrow | escape }}</span>
                  {%- endif -%}
                  {%- if gd.title != blank -%}
                    <h3 class="gg-h3 gg-disc__title">{{ gd.title | escape }}</h3>
                  {%- endif -%}
                  {%- if gd.text != blank -%}
                    <p class="gg-disc__text">{{ gd.text | escape }}</p>
                  {%- endif -%}
                  {%- if gd.product != blank and gd.button_label != blank -%}
                    <div class="gg-disc__cta">
                      <a class="gg-btn gg-btn--secondary gg-btn--block" href="{{ gd.product.url }}">
                        {{- gd.button_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if gs.carousel -%}
        <div class="gg-carousel__nav" data-gg-nav hidden>
          <button type="button" class="gg-carousel__btn" data-gg-prev aria-label="{{ gs.prev_label | default: 'Previous' | escape }}">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="gg-carousel__btn" data-gg-next aria-label="{{ gs.next_label | default: 'Next' | escape }}">
            <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
        </gg-carousel>
      {%- endif -%}
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'build_tile' -%}
        {%- assign gt = block.settings -%}
        <div class="gg-tile" {{ block.shopify_attributes }}>
          <div class="gg-tile__text">
            {%- if gt.eyebrow != blank -%}
              <span class="gg-eyebrow">{{ gt.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if gt.title != blank -%}
              <h3 class="gg-h3 gg-tile__title">{{ gt.title | escape }}</h3>
            {%- endif -%}
            {%- if gt.text != blank -%}
              <p class="gg-tile__copy">{{ gt.text | escape }}</p>
            {%- endif -%}
          </div>
          {%- if gt.button_label != blank and gt.link != blank -%}
            <a class="gg-btn gg-btn--primary gg-tile__btn" href="{{ gt.link | escape }}">
              {{- gt.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Gift sets",
  "tag": "section",
  "class": "gg-section pm-scope",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (without #)",
      "info": "For links, e.g. for-her. The link is then #for-her."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ready to give"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gift sets for her"
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Width",
      "options": [
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        }
      ],
      "default": "wide"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "carousel",
      "label": "Carousel on desktop",
      "info": "Shows as many cards as columns and pages with arrows. Phones always swipe.",
      "default": false
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous arrow (screen readers)",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next arrow (screen readers)",
      "default": "Next"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "surface",
          "label": "Grey"
        },
        {
          "value": "surface-2",
          "label": "Light grey"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing (desktop)",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "header",
      "content": "Card texts"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge on sale",
      "default": "Special offer"
    },
    {
      "type": "text",
      "id": "atc_label",
      "label": "Button",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "choose_label",
      "label": "Button for pick-your-own sets",
      "info": "For bundles without fixed scents (e.g. 8 x 50 ml): the button opens the product page.",
      "default": "Choose your scents"
    },
    {
      "type": "text",
      "id": "soldout_label",
      "label": "Button sold out",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Button after adding",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "error_label",
      "label": "Error message",
      "default": "Something went wrong. Please try again."
    },
    {
      "type": "text",
      "id": "boxed_line",
      "label": "Line under the button",
      "default": "Every bottle boxed on its own, ready to give"
    },
    {
      "type": "text",
      "id": "contents_heading",
      "label": "Contents heading",
      "default": "What's inside"
    },
    {
      "type": "text",
      "id": "number_label",
      "label": "Scent number",
      "info": "[n] = number.",
      "default": "No. [n]"
    },
    {
      "type": "text",
      "id": "inspired_word",
      "label": "Word before the inspiration",
      "default": "Inspired by"
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Product link",
      "default": "All details"
    },
    {
      "type": "checkbox",
      "id": "show_swap",
      "label": "Show swap a scent",
      "info": "Opens the set builder with this set's scents.",
      "default": true
    },
    {
      "type": "range",
      "id": "swap_max",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "label": "Swap a scent up to set size",
      "info": "Largest set the set builder sells. Bigger sets show no swap link."
    },
    {
      "type": "text",
      "id": "swap_label",
      "label": "Swap a scent",
      "default": "Swap a scent"
    }
  ],
  "blocks": [
    {
      "type": "gift_set",
      "name": "Gift set",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Gift set product",
          "info": "Bundle with custom.fixed_bundle_products. Title, subtitle and text come from the gift_* metafields."
        }
      ]
    },
    {
      "type": "discovery",
      "name": "Discovery set",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Discovery set product",
          "info": "Empty = tile without button (coming soon)."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Not sure what they like?"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Let them choose."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "The discovery set is coming soon. They find their favourite scent themselves."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "See the discovery set"
        }
      ]
    },
    {
      "type": "build_tile",
      "name": "Build your own",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Build your own"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Know his scent? Pick three."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Same price, same packaging. You choose the three scents."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "Build a set"
        },
        {
          "type": "text",
          "id": "link",
          "label": "Link",
          "info": "Anchor on this page (e.g. #build-your-own) or a URL.",
          "default": "#build-your-own"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Gift sets",
      "blocks": [
        {
          "type": "gift_set"
        },
        {
          "type": "gift_set"
        },
        {
          "type": "gift_set"
        }
      ]
    }
  ]
}
{% endschema %}
