{%- comment -%}
  Heading band above a collection grid (payday collection). magicperfume.co's FM preview shows this band on its
  payday-lander: its popular-products section with an empty collection, so only the heading renders. aaroma's own
  popular-products cannot do that (it always prints an empty bordered button and a second #product-grid list, which
  the filter bar, the grid loader and the collection search would pick up instead of the real grid), so this section
  renders exactly that output and nothing else: same markup and classes as magicperfume's popular-products heading
  row (36 / 36px padding, 0.75 of that on phones, 30 / 36px black-weight heading), background colour as a setting.
  The heading is a setting saved in the template (translatable).
{%- endcomment -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- if section.settings.heading != blank -%}
  <div id="{{ section.id }}" class="section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-3xl md:text-4xl font-black my-0">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
  {
    "name": "Collection heading band",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Heading"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colour",
        "default": "#fcfbf9"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding bottom",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Collection heading band"
      }
    ]
  }
{% endschema %}
