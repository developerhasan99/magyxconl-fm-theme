{%- comment -%}
  Bundle & Save page: customer video carousel (replaces the photo review cards, Adrian 01.11).
  Tiles are the site's own UGC tiles (snippets/fuel05-ugc-tile.liquid + assets/fuel05-ugc.js), so play on
  tap, mute handling and warm-up behave the same as the homepage row. The script arms every
  .fuel05-ugc[data-fuel05-row] root and starts Swiper on .fuel05-ugc__slider (slidesPerView auto,
  gaps from data-gap-*, arrows = .fuel05-ugc__arrow--prev / --next). Tile widths as the homepage row:
  175px on phones (swipe, no arrows), 220px from 750, 265px from 990 with round arrows on the sides.
  The product pill shows from 750 (the tile snippet hides it on phones), compact on tiles under 260px.
  aaroma.co (04.11.2026): copy of magicperfume.co's; arrow labels = aaroma.misc.prev_video / next_video t-keys,
  rating line = rating text setting (Judge.me off in the template, aaroma has no Judge.me reviews).
  Language (05.11.2026): each video has a Language setting; a page shows only the videos in
  its own language (snippets/ugc-lang-match). No video for the language = no carousel at all.
{%- endcomment -%}
{%- liquid
  assign ugc_visible = 0
  for block in section.blocks
    capture ugc_ok
      render 'ugc-lang-match', lang: block.settings.language
    endcapture
    assign ugc_ok = ugc_ok | strip
    if ugc_ok != '0'
      assign ugc_visible = ugc_visible | plus: 1
    endif
  endfor
-%}
{%- if ugc_visible > 0 -%}
  {{ 'fuel05-ugc.css' | asset_url | stylesheet_tag }}
  {{ 'pm-s-bs-ugc-grid.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'fuel05-ugc.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- style -%}
  .premium .pm-bsug--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-bsug--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if ugc_visible > 0 -%}
  <div
    id="{{ section.id }}"
    class="pm-bsug pm-bsug--{{ section.id }} fuel05-ugc color-{{ section.settings.color_scheme }} gradient"
    data-fuel05-row
    data-gap-mobile="8"
    data-gap-desktop="12">
    <div class="page-width">
      <div class="pm-bsug__head">
        {%- capture pm_ug_rating -%}{%- render 'pm-bs-judgeme-text', use_judgeme: section.settings.use_judgeme, fallback: section.settings.rating_text -%}{%- endcapture -%}
        {%- assign pm_ug_rating = pm_ug_rating | strip -%}
        {%- if pm_ug_rating != blank -%}
          <p class="pm-bsug__rating">
            {% render 'pm-stars', size: 12 %}
            <span class="pm-small">{{ pm_ug_rating }}</span>
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pm-h2 pm-bsug__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="pm-body-lg pm-muted pm-bsug__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="pm-bsug__stage">
        <button type="button" class="fuel05-ugc__arrow fuel05-ugc__arrow--prev pm-bsug__arrow pm-bsug__arrow--prev" aria-label="{{ 'aaroma.misc.prev_video' | t | escape }}">
          {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
        </button>
        <div class="fuel05-ugc__slider swiper">
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              {%- capture ugc_ok -%}{% render 'ugc-lang-match', lang: block.settings.language %}{%- endcapture -%}
              {%- assign ugc_ok = ugc_ok | strip -%}
              {%- if ugc_ok != '0' -%}
                {%- assign ugc_editor_lang = '' -%}
                {%- if ugc_ok == 'editor' -%}{%- assign ugc_editor_lang = block.settings.language | default: 'nl' -%}{%- endif -%}
                {% render 'pm-bs-ugc-tile',
                  video: block.settings.video,
                  video_url: block.settings.video_url,
                  poster_url: block.settings.poster_url,
                  product_item: block.settings.product,
                  shopify_attributes: block.shopify_attributes,
                  editor_lang: ugc_editor_lang
                %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        <button type="button" class="fuel05-ugc__arrow fuel05-ugc__arrow--next pm-bsug__arrow pm-bsug__arrow--next" aria-label="{{ 'aaroma.misc.next_video' | t | escape }}">
          {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
        </button>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width pm-bsug__empty">Add video blocks to show the customer video carousel.</div>
{%- endif -%}

{% schema %}
{
  "name": "BS customer videos",
  "tag": "section",
  "class": "section premium pm-scope",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "use_judgeme",
      "label": "Judge.me numbers",
      "default": true,
      "info": "Rating line with the shop's live Judge.me numbers. Off or no numbers: the rating text."
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating line",
      "default": "Verified customer reviews",
      "info": "Shown when Judge.me numbers are off or missing. No fixed review counts."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The scent that turns heads"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From stolen glances to compliments"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "select",
          "id": "language",
          "label": "Language",
          "options": [
            { "value": "nl", "label": "Dutch" },
            { "value": "fr", "label": "French" },
            { "value": "en", "label": "English" },
            { "value": "all", "label": "Every language" }
          ],
          "default": "nl",
          "info": "The language spoken in the video. It only shows on pages in that language."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Pick from Files. When empty, the video URL below is used."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (mp4)"
        },
        {
          "type": "text",
          "id": "poster_url",
          "label": "Poster image URL",
          "info": "Only used with the video URL."
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product pill",
          "info": "Shown on the video from tablet width up."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BS customer videos",
      "settings": {
        "color_scheme": "scheme-1",
        "use_judgeme": true,
        "rating_text": "Verified customer reviews",
        "heading": "The scent that turns heads",
        "subheading": "From stolen glances to compliments",
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}
