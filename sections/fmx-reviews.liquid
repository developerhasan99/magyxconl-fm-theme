{%- comment -%}
  fmx-reviews (aaroma.co): port of magicperfume.co sections/fmx-reviews.liquid (= tryscent.co premium-redesign), FM
  review cards in a masonry grid + load-more button. Scope .fmx-scope (body is .premium on this theme), English.
  aaroma has no Judge.me reviews (decided exception): this section carries aaroma's OWN live review content, i.e.
  the blocks of its massive-review section. The block schema is massive-review's 1:1 and the section keeps the
  massive-review setting ids (heading, review_text, button_text, button_link, background_color), so
  docs/pdp-parity/build_templates.py only switches the section type: section id, block ids and every text value
  (and their translations) stay as they are. Stars printed in review_text ("★★★★★ 4.9 / 5 ...") are dropped,
  the FM header draws its own stars. Fixed labels are locale keys (aaroma.common.verified_buyer,
  aaroma.misc.loading_reviews, premium.reviews.rating_aria, premium.general.previous / next).
{%- endcomment -%}
{{ 'fmx-base.css' | asset_url | stylesheet_tag }}
{{ 'fmx-sections.css' | asset_url | stylesheet_tag }}
{{ 'fmx-s-massive-review.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign initial_count = section.settings.initial_count | default: 20
  assign cols_desktop = section.settings.columns_desktop | default: '3'
  assign cols_mobile = section.settings.columns_mobile | default: '2'
-%}
{%- style -%}
  .fmx-scope .pm-reviews--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .fmx-scope .pm-reviews--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="fmx-scope">
<span id="reviews" class="pm-anchor"></span>
<div
  id="{{ section.id }}"
  class="pm-reviews pm-reviews--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="pm-reviews__head">
      <h2 class="pm-h2 pm-reviews__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.review_text != blank -%}
        <div class="pm-reviews__rating">
          {% render 'fmx-stars', rating: section.settings.rating_value, size: 12 %}
          <span class="pm-small pm-muted">{{ section.settings.review_text | remove: '★' | strip }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} layout = carousel: the same cards as Swiper slides; grid (default): masonry + Load more {%- endcomment -%}
    {%- assign is_carousel = false -%}
    {%- if section.settings.layout == 'carousel' -%}{%- assign is_carousel = true -%}{%- endif -%}
    {%- if is_carousel -%}
      <div class="pm-reviews__slider swiper" data-pm-reviews-swiper>
        <div class="swiper-wrapper">
    {%- else -%}
      <div id="reviews-source-{{ section.id }}" hidden>
    {%- endif -%}
      {%- for block in section.blocks -%}
        {%- assign rating = block.settings.rating | default: 5 | plus: 0 -%}
        {%- if is_carousel -%}<div class="swiper-slide pm-reviews__slide">{%- endif -%}
        <article
          class="review-item pm-review"
          data-review-index="{{ forloop.index }}"
          {{ block.shopify_attributes }}>
          {%- if block.settings.review_image != blank -%}
            <img
              class="pm-review__img"
              src="{{ block.settings.review_image | image_url: width: 540 }}"
              srcset="{{ block.settings.review_image | image_url: width: 360 }} 360w, {{ block.settings.review_image | image_url: width: 540 }} 540w, {{ block.settings.review_image | image_url: width: 720 }} 720w"
              sizes="(min-width: 990px) 360px, (min-width: 750px) 45vw, 90vw"
              alt="{{ block.settings.review_image.alt | escape }}"
              width="{{ block.settings.review_image.width }}"
              height="{{ block.settings.review_image.height }}"
              loading="lazy">
          {%- endif -%}
          <div class="pm-review__body">
            <div class="pm-review__meta">
              <div class="pm-review__who">
                {%- if block.settings.author_image != blank -%}
                  <img
                    class="pm-review__avatar"
                    src="{{ block.settings.author_image | image_url: width: 64, height: 64 }}"
                    alt=""
                    width="32"
                    height="32"
                    loading="lazy">
                {%- endif -%}
                <div>
                  {%- if block.settings.author != blank -%}<p class="pm-review__name">{{ block.settings.author }}</p>{%- endif -%}
                  {%- if block.settings.show_verified_badge -%}
                    <span class="pm-review__verified">{% render 'fmx-icon', icon: 'check', size: 12, stroke: 2 %}{{ 'aaroma.common.verified_buyer' | t }}</span>
                  {%- endif -%}
                </div>
              </div>
              <div class="pm-review__rating">
                <span class="pm-review__stars" role="img" aria-label="{{ 'premium.reviews.rating_aria' | t: rating: rating }}">
                  {%- for i in (1..5) -%}
                    <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endfor -%}
                </span>
                {%- if block.settings.date != blank -%}
                  <span class="pm-review__date">{{ block.settings.date }}</span>
                {%- endif -%}
              </div>
            </div>
            <div class="pm-review__text rte">
              {{ block.settings.content }}
            </div>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="pm-review__product">
                <img
                  src="{{ block.settings.product.featured_image | image_url: width: 64, height: 64 }}"
                  alt="{{ block.settings.product.title | escape }}"
                  width="32"
                  height="32"
                  loading="lazy">
                <div>
                  <p class="pm-review__product-title">{{ block.settings.product.title }}</p>
                </div>
              </a>
            {%- endif -%}
          </div>
        </article>
        {%- if is_carousel -%}</div>{%- endif -%}
      {%- endfor -%}
    {%- if is_carousel -%}
        </div>
        <div class="pm-reviews__nav">
          <button type="button" class="swiper-button-prev" aria-label="{{ 'premium.general.previous' | t }}"></button>
          <button type="button" class="swiper-button-next" aria-label="{{ 'premium.general.next' | t }}"></button>
        </div>
      </div>
    {%- else -%}
      </div>
    {%- endif -%}

    {%- unless is_carousel -%}
    <div
      id="reviews-container-{{ section.id }}"
      class="masonry-grid masonry-container pm-reviews__grid"
      data-pm-cols-desktop="{{ cols_desktop }}"
      data-pm-cols-mobile="{{ cols_mobile }}"></div>

    <div id="load-more-container-{{ section.id }}" class="pm-reviews__more"{% if section.blocks.size <= initial_count %} hidden{% endif %}>
      <button id="load-more-btn-{{ section.id }}" type="button" class="pm-btn pm-btn--secondary">
        {{ section.settings.button_text }}
      </button>
      <div id="loading-spinner-{{ section.id }}" class="pm-reviews__loading" hidden>
        <div class="loading-spinner pm-reviews__spinner"></div>
        <span class="pm-small pm-muted">{{ 'aaroma.misc.loading_reviews' | t }}</span>
      </div>
    </div>
    {%- endunless -%}
  </div>
</div>

{%- if is_carousel -%}
<style>
  .fmx-scope .pm-reviews__slider { overflow: hidden; }
  .fmx-scope .pm-reviews__slider .swiper-slide { height: auto; }
  .fmx-scope .pm-reviews__slide .pm-review { height: 100%; }
  .fmx-scope .pm-reviews__nav { display: none; }
  @media screen and (min-width: 750px) {
    .fmx-scope .pm-reviews__nav { display: flex; justify-content: center; gap: 12px; margin-top: 24px; }
    .fmx-scope .pm-reviews__nav .swiper-button-prev,
    .fmx-scope .pm-reviews__nav .swiper-button-next { position: static; margin: 0; }
    .fmx-scope .pm-reviews__nav .swiper-button-disabled { opacity: 0.3; pointer-events: none; }
  }
</style>
<script>
  (function() {
    // Swiper is loaded with defer in layout/theme.liquid, so it exists by DOMContentLoaded
    function init() {
      var el = document.querySelector('#{{ section.id }} [data-pm-reviews-swiper]');
      if (!el || el.swiper || !window.Swiper) return;
      new Swiper(el, {
        slidesPerView: 1.15,
        spaceBetween: 12,
        watchOverflow: true,
        navigation: { prevEl: el.querySelector('.swiper-button-prev'), nextEl: el.querySelector('.swiper-button-next') },
        breakpoints: { 750: { slidesPerView: 2.2, spaceBetween: 16 }, 990: { slidesPerView: 3, spaceBetween: 20 } }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') init();
    });
  })();
</script>
{%- else -%}
<script>
  (function() {
  const sectionId = '{{ section.id }}';
  const btn = document.getElementById(`load-more-btn-${sectionId}`);
  const spinner = document.getElementById(`loading-spinner-${sectionId}`);
  const container = document.getElementById(`reviews-container-${sectionId}`);
  const sourceContainer = document.getElementById(`reviews-source-${sectionId}`);
  const loadMoreContainer = document.getElementById(`load-more-container-${sectionId}`);

  let currentlyShowing = 0;
  const totalReviews = {{ section.blocks.size }};
  const initialLoad = {{ initial_count }};
  const desktopCols = parseInt(container.getAttribute('data-pm-cols-desktop'), 10) || 3;
  const mobileCols = parseInt(container.getAttribute('data-pm-cols-mobile'), 10) || 2;

  function columnsFor(width) {
    if (width >= 990) return desktopCols;
    if (width >= 750) return Math.min(desktopCols, 2);
    return mobileCols;
  }

  let columns = [];
  let columnHeights = [];
  let numColumns = columnsFor(window.innerWidth);

  // Initialize columns
  function initColumns() {
    container.innerHTML = '';
    columns = [];
    columnHeights = [];
    numColumns = columnsFor(window.innerWidth);

    for (let i = 0; i < numColumns; i++) {
      const col = document.createElement('div');
      col.className = 'masonry-column';
      container.appendChild(col);
      columns.push(col);
      columnHeights.push(0);
    }
  }

  // Get shortest column index
  function getShortestColumnIndex() {
    let minHeight = columnHeights[0];
    let minIndex = 0;

    for (let i = 1; i < columnHeights.length; i++) {
      if (columnHeights[i] < minHeight) {
        minHeight = columnHeights[i];
        minIndex = i;
      }
    }

    return minIndex;
  }

  // Add reviews to masonry layout
  function addReviews(count) {
    const allReviews = sourceContainer.querySelectorAll('.review-item');
    const end = Math.min(currentlyShowing + count, totalReviews);

    for (let i = currentlyShowing; i < end; i++) {
      if (allReviews[i]) {
        const clone = allReviews[i].cloneNode(true);
        clone.style.opacity = '0';

        // Get the shortest column
        const shortestIndex = getShortestColumnIndex();
        columns[shortestIndex].appendChild(clone);

        // Force a reflow to get accurate height
        clone.offsetHeight;

        // Update the height tracking (approximate)
        const cardHeight = clone.offsetHeight || 300; // fallback height
        columnHeights[shortestIndex] += cardHeight + 12; // 12px is the gap

        // Trigger fade in
        setTimeout(() => {
          clone.style.opacity = '';
        }, 10);
      }
    }

    currentlyShowing = end;

    // Recalculate actual heights after all cards are added
    setTimeout(() => {
      for (let i = 0; i < columns.length; i++) {
        columnHeights[i] = columns[i].offsetHeight;
      }
    }, 100);
  }

  // Handle window resize
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      const newNumColumns = columnsFor(window.innerWidth);
      if (newNumColumns !== numColumns) {
        const tempShowing = currentlyShowing;
        currentlyShowing = 0;
        initColumns();
        addReviews(tempShowing);
      }
    }, 250);
  });

  // Initial load
  initColumns();
  addReviews(initialLoad);

  // Load more button
  if (btn) {
    btn.addEventListener('click', function() {
      btn.hidden = true;
      spinner.hidden = false;

      setTimeout(function() {
        addReviews(10);

        spinner.hidden = true;

        if (currentlyShowing < totalReviews) {
          btn.hidden = false;
        } else {
          loadMoreContainer.hidden = true;
        }
      }, 800);
    });
  }
  })();
</script>
{%- endif -%}
</div>

{% schema %}
  {
    "name": "FM reviews",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-1"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Trusted by 10,000+ customers."
      },
      {
        "type": "text",
        "id": "review_text",
        "label": "Review Text",
        "info": "Shown next to the stars in the header.",
        "default": "4.9 / 5 — more than 10,000 reviews"
      },
      {
        "type": "text",
        "id": "rating_value",
        "label": "Average rating (stars label)",
        "info": "Leave empty to show stars without a number."
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "info": "Carousel shows every review in a swipe row (arrows from 750px); the settings below only apply to the grid.",
        "options": [
          { "value": "grid", "label": "Grid with Load more" },
          { "value": "carousel", "label": "Carousel" }
        ],
        "default": "grid"
      },
      {
        "type": "range",
        "id": "initial_count",
        "label": "Reviews shown before Load more",
        "min": 1,
        "max": 40,
        "step": 1,
        "default": 6
      },
      {
        "type": "select",
        "id": "columns_desktop",
        "label": "Columns from 990px",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" },
          { "value": "3", "label": "3" },
          { "value": "4", "label": "4" }
        ],
        "default": "2"
      },
      {
        "type": "select",
        "id": "columns_mobile",
        "label": "Columns below 750px",
        "options": [
          { "value": "1", "label": "1" },
          { "value": "2", "label": "2" }
        ],
        "default": "1"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Load more button text",
        "default": "See more reviews"
      },
      {
        "type": "url",
        "id": "button_link",
        "label": "Button link (unused)"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colour (unused)",
      "info": "Kept from the old section. The FM band uses the colour scheme."
      },
      {
        "type": "header",
        "content": "Section padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding top",
        "info": "Half of this value below 990px.",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "image_picker",
            "id": "review_image",
            "label": "Review Image"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Review Content",
            "default": "<p>\"Great scent.\"</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author Name",
            "default": "Customer"
          },
          {
            "type": "image_picker",
            "id": "author_image",
            "label": "Author Image"
          },
          {
            "type": "text",
            "id": "date",
            "label": "Date",
            "default": "2 weeks ago"
          },
          {
            "type": "range",
            "id": "rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "label": "Rating",
            "default": 5
          },
          {
            "type": "checkbox",
            "id": "show_verified_badge",
            "label": "Show Verified Badge",
            "default": true
          },
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }

        ]
      }
    ],
    "presets": [
      {
        "name": "FM reviews"
      }
    ]
  }
{% endschema %}
