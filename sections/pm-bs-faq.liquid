{{ 'pm-s-bs-faq.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .premium .pm-bs-faq--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .premium .pm-bs-faq--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
  assign half = questions.size | plus: 1 | divided_by: 2
-%}
<div
  id="{{ section.id }}"
  class="pm-bs-faq pm-bs-faq--{{ section.id }} color-{{ section.settings.color_scheme }} gradient{% if section.settings.soft_bg %} pm-bs--soft{% endif %}"
  data-pm-bs-faq>
  <div class="page-width">
    {%- if section.settings.title != blank -%}
      <h2 class="pm-h2 pm-bs-faq__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="pm-bs-faq__cols">
      <div class="pm-bs-faq__col">
        {%- for block in questions -%}
          {%- if forloop.index <= half -%}
            <div class="pm-bs-faq__item" {{ block.shopify_attributes }}>
              <h3 class="pm-bs-faq__q">
                <button
                  type="button"
                  class="pm-bs-faq__btn"
                  id="pm-bs-faq-btn-{{ block.id }}"
                  aria-expanded="false"
                  aria-controls="pm-bs-faq-panel-{{ block.id }}">
                  <span class="pm-bs-faq__q-text">{{ block.settings.question }}</span>
                  <span class="pm-bs-faq__icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div
                class="pm-bs-faq__panel"
                id="pm-bs-faq-panel-{{ block.id }}"
                role="region"
                aria-labelledby="pm-bs-faq-btn-{{ block.id }}">
                <div class="pm-bs-faq__panel-inner">
                  <div class="pm-bs-faq__a">{{ block.settings.answer }}</div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="pm-bs-faq__col">
        {%- for block in questions -%}
          {%- if forloop.index > half -%}
            <div class="pm-bs-faq__item" {{ block.shopify_attributes }}>
              <h3 class="pm-bs-faq__q">
                <button
                  type="button"
                  class="pm-bs-faq__btn"
                  id="pm-bs-faq-btn-{{ block.id }}"
                  aria-expanded="false"
                  aria-controls="pm-bs-faq-panel-{{ block.id }}">
                  <span class="pm-bs-faq__q-text">{{ block.settings.question }}</span>
                  <span class="pm-bs-faq__icon" aria-hidden="true"></span>
                </button>
              </h3>
              <div
                class="pm-bs-faq__panel"
                id="pm-bs-faq-panel-{{ block.id }}"
                role="region"
                aria-labelledby="pm-bs-faq-btn-{{ block.id }}">
                <div class="pm-bs-faq__panel-inner">
                  <div class="pm-bs-faq__a">{{ block.settings.answer }}</div>
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.closing_text != blank -%}
      <div class="pm-bs-faq__closing">{{ section.settings.closing_text }}</div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function initFaq(root) {
      if (!root || root.dataset.started === '1') return;
      root.dataset.started = '1';
      root.classList.add('is-js');

      function setOpen(item, open) {
        var btn = item.querySelector('.pm-bs-faq__btn');
        if (!btn) return;
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        item.classList.toggle('is-open', open);
      }

      root.querySelectorAll('.pm-bs-faq__item').forEach(function (item) {
        var btn = item.querySelector('.pm-bs-faq__btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          setOpen(item, btn.getAttribute('aria-expanded') !== 'true');
        });
      });

      root.addEventListener('shopify:block:select', function (e) {
        var item = e.target && e.target.closest ? e.target.closest('.pm-bs-faq__item') : null;
        if (item) setOpen(item, true);
      });
      root.addEventListener('shopify:block:deselect', function (e) {
        var item = e.target && e.target.closest ? e.target.closest('.pm-bs-faq__item') : null;
        if (item) setOpen(item, false);
      });
    }

    function scan(scope) {
      (scope || document).querySelectorAll('[data-pm-bs-faq]').forEach(initFaq);
    }

    scan(document);
    if (!window.pmBsFaqBound) {
      window.pmBsFaqBound = true;
      document.addEventListener('shopify:section:load', function (e) {
        scan(e.target);
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Bundle: FAQ",
  "tag": "section",
  "class": "premium pm-scope",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "soft_bg",
      "label": "Soft grey background",
      "default": true,
      "info": "tryscent.co colour scheme 5 (#f6f6f6). This store's scheme 5 is the sale red, so the section draws the grey itself."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "closing_text",
      "label": "Text below the questions",
      "default": "<p>Have another question? <a href=\"/pages/contact-us\">Write to us</a>.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle: FAQ",
      "settings": {
        "color_scheme": "scheme-1",
        "title": "Frequently asked questions",
        "closing_text": "<p>Have another question? <a href=\"/pages/contact-us\">Write to us</a>.</p>",
        "padding_top": 80,
        "padding_bottom": 80,
        "soft_bg": true
      },
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is an inspired scent?",
            "answer": "<p>A scent with the same notes and the same scent family as a well-known perfume. It is not the original.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How much fragrance oil is in the perfumes?",
            "answer": "<p>20% fragrance oils, as much as in an Eau de Parfum. The scent is clearly noticeable and lasts long without being overpowering.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How long does the scent last?",
            "answer": "<p>Up to 12 hours for most people. How long it lasts depends on your skin, so spray it on your skin, not on your clothes.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Can I mix different scents in one bundle?",
            "answer": "<p>Yes. Pick the scents you want, in any combination, including the same scent more than once. The price only depends on how many bottles your bundle has.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where are the perfumes made?",
            "answer": "<p>In Europe.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Why are your scents so affordable?",
            "answer": "<p>We put the money into the scent. No luxury bottles, no expensive packaging, no shop rents and no expensive influencer deals. So you smell like luxury without paying a fortune.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "When will my order arrive?",
            "answer": "<p>We ship within 48 hours, with tracking. You will see the delivery time for your country and the shipping options at checkout.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if I don't like a scent?",
            "answer": "<p>You have a 60-day money-back guarantee. If a scent isn't right for you, simply send your order back.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are these original perfumes from well-known brands?",
            "answer": "<p>No. They are scents inspired by well-known compositions. MagyX is not affiliated with or endorsed by the brands named.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
