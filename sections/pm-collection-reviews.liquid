{{ 'pm-collection-reviews.css' | asset_url | stylesheet_tag }}
{%- liquid
  # Rating line: the shop's live Judge.me numbers (shop metafields judgeme.all_reviews_rating / all_reviews_count, as
  # magicperfume.co's snippets/pm-bs-judgeme-text), in the saved format "[rating]/5 stars ([count] reviews)" with the
  # page language's number format (en 4.7 / 1,423, fr 4,7 / 1 423, nl and others 4,7 / 1.423). Numbers off or missing:
  # the saved rating text.
  assign pm_cr_rating = section.settings.rating_text
  assign jm_rating = shop.metafields.judgeme.all_reviews_rating | plus: 0
  assign jm_count = shop.metafields.judgeme.all_reviews_count | plus: 0
  if section.settings.use_judgeme and jm_rating > 0 and jm_count > 0 and section.settings.judgeme_format != blank
    assign jm_lang = request.locale.iso_code | slice: 0, 2
    assign jm_dec = ','
    assign jm_thou = '.'
    if jm_lang == 'en'
      assign jm_dec = '.'
      assign jm_thou = ','
    elsif jm_lang == 'fr'
      assign jm_thou = ' '
    endif
    assign jm_rating_text = jm_rating | round: 1 | append: '' | replace: '.', jm_dec
    if jm_count >= 1000
      assign jm_k = jm_count | divided_by: 1000
      assign jm_rest = jm_count | modulo: 1000 | prepend: '00' | slice: -3, 3
      assign jm_count_text = jm_k | append: jm_thou | append: jm_rest
    else
      assign jm_count_text = jm_count | append: ''
    endif
    assign pm_cr_rating = section.settings.judgeme_format | replace: '[rating]', jm_rating_text | replace: '[count]', jm_count_text
  endif
-%}
{%- style -%}
  .premium .pm-creviews--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-creviews--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Review carousel of the collection landers: port of the magicperfume.co FM redesign sections/pm-collection-reviews.liquid
  (tryscent.co sections/fmx-reviews.liquid, layout "carousel"): heading left, stars + rating line right, white bordered
  cards (1.15 / 2.2 / 3 per view, gap 12 / 16 / 20), arrows centred under the row from 750px. Same card markup and
  classes (.pm-review*, styled by pm-sections.css). Scroll-snap instead of Swiper (Swiper is not loaded on collection pages).
  Aaroma: content = real Judge.me reviews of aaroma.co (blocks written verbatim from docs/reviews/judgeme-all.json by
  docs/collections/build_templates.py: author, rating, Judge.me verified flag, Judge.me date); the rating line = the
  live Judge.me numbers (see above). Every visible text is a setting saved in the template (translatable).
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div
    id="{{ section.id }}"
    class="pm-creviews pm-creviews--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="pm-creviews__head">
        <h2 class="pm-h2 pm-creviews__heading">{{ section.settings.heading }}</h2>
        {%- if pm_cr_rating != blank -%}
          <div class="pm-creviews__rating">
            {% render 'pm-stars', size: 12 %}
            <span class="pm-small pm-muted">{{ pm_cr_rating | escape }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="pm-creviews__slider" data-pm-cr>
        <ul class="pm-creviews__track" role="list" data-pm-cr-track>
          {%- for block in section.blocks -%}
            {%- assign rating = block.settings.rating | default: 5 | plus: 0 -%}
            {%- capture rating_label -%}{{ section.settings.rating_label | replace: '[rating]', rating }}{%- endcapture -%}
            <li class="pm-creviews__slide" data-pm-cr-card {{ block.shopify_attributes }}>
              <article class="pm-review">
                <div class="pm-review__body">
                  <div class="pm-review__meta">
                    <div class="pm-review__who">
                      <div>
                        {%- if block.settings.author != blank -%}<p class="pm-review__name">{{ block.settings.author }}</p>{%- endif -%}
                        {%- if block.settings.show_verified_badge -%}
                          <span class="pm-review__verified">{% render 'pm-icon', icon: 'check', size: 12, stroke: 2 %}{{ section.settings.verified_text }}</span>
                        {%- endif -%}
                      </div>
                    </div>
                    <div class="pm-review__rating">
                      <span class="pm-review__stars" role="img" aria-label="{{ rating_label | escape }}">
                        {%- for i in (1..5) -%}
                          <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                        {%- endfor -%}
                      </span>
                      {%- if block.settings.date != blank -%}
                        <span class="pm-review__date">{{ block.settings.date }}</span>
                      {%- endif -%}
                    </div>
                  </div>
                  <div class="pm-review__text rte">
                    {{ block.settings.content }}
                  </div>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
        <div class="pm-creviews__nav">
          <button type="button" class="pm-creviews__arrow pm-creviews__arrow--prev" data-pm-cr-prev aria-label="{{ section.settings.prev_label | escape }}" disabled>
            {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
          </button>
          <button type="button" class="pm-creviews__arrow pm-creviews__arrow--next" data-pm-cr-next aria-label="{{ section.settings.next_label | escape }}">
            {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var root = document.getElementById('{{ section.id }}');
      if (!root || root.hasAttribute('data-started')) return;
      root.setAttribute('data-started', '1');
      var track = root.querySelector('[data-pm-cr-track]');
      var prev = root.querySelector('[data-pm-cr-prev]');
      var next = root.querySelector('[data-pm-cr-next]');
      if (!track) return;
      function step() {
        var card = track.querySelector('[data-pm-cr-card]');
        if (!card) return track.clientWidth;
        var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
        return card.getBoundingClientRect().width + gap;
      }
      function update() {
        var max = track.scrollWidth - track.clientWidth - 2;
        if (prev) prev.disabled = track.scrollLeft <= 2;
        if (next) next.disabled = track.scrollLeft >= max;
      }
      function go(dir) {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({ left: dir * step(), behavior: reduce ? 'auto' : 'smooth' });
      }
      if (prev) prev.addEventListener('click', function () { go(-1); });
      if (next) next.addEventListener('click', function () { go(1); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
{%- elsif request.design_mode -%}
  <div class="page-width"><p class="pm-small pm-muted">Add real customer reviews as blocks.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Collection reviews",
  "tag": "section",
  "class": "premium pm-scope",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "checkbox", "id": "use_judgeme", "label": "Judge.me numbers", "default": true, "info": "The shop's live Judge.me rating and review count in the rating line" },
    { "type": "text", "id": "judgeme_format", "label": "Judge.me rating line", "default": "[rating]/5 stars ([count] reviews)", "info": "[rating] and [count] = Judge.me's numbers" },
    { "type": "text", "id": "rating_text", "label": "Rating text (fallback)", "info": "Shown when the Judge.me numbers are off or missing. Empty = hidden." },
    { "type": "text", "id": "verified_text", "label": "Verified label", "default": "Verified buyer" },
    { "type": "text", "id": "rating_label", "label": "Card stars (screen readers)", "default": "[rating] out of 5 stars", "info": "[rating] = the card's rating" },
    { "type": "text", "id": "prev_label", "label": "Previous (aria)", "default": "Previous review" },
    { "type": "text", "id": "next_label", "label": "Next (aria)", "default": "Next review" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 56 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Review" },
        { "type": "text", "id": "author", "label": "Author" },
        { "type": "text", "id": "date", "label": "Date text" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
        { "type": "checkbox", "id": "show_verified_badge", "label": "Verified badge", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "Collection reviews" }]
}
{% endschema %}
