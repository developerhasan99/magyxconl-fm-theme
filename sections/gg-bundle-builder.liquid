{%- comment -%}
  gg-bundle-builder: "Build your own" builder of the Gift Guide. Visual layer only: the discount is the store's
  own automatic quantity discount (Shopify applies it at cart and checkout), the builder just shows it.
  Layout: top = product card (image | "Your set" box: bottles in cart, discount steps, saving, gift packaging,
  checkout button, trust row), below = filters (ready-made gift sets, gender, scent family, search) + scent card
  grid with infinite scroll, plus a sticky bar (count, %, saving, next step) while the builder is on screen.
  Cart (assets/gg-builder.js): a tap on a scent adds its 50 ml variant to the cart as a normal line, − removes one.
  Ready-made sets go in as their own line (GG.bundleItem: "Bottle N" + _bundle_items), they never count toward the
  quantity discount. Gift packaging = its own line, toggled from the box.
  Discount steps (setting "2:25,4:30,6:35,8:40") must mirror the automatic discounts in Shopify; counted bottles =
  cart lines of products in the discount collections (setting) or lines Shopify already discounted, minus set lines,
  free gifts and the packaging. Saving = what Shopify actually took off those lines (cart.js), never estimated.
  Gift cards elsewhere on the page call GG.preset(ids) -> window 'gg:preset' -> those scents pin to the top of the grid.
  magyxco.nl (port of tryscent.co 6be5e1f): English source, native Shopify translations (no Weglot). Every string the
  JS writes is a section setting, so the store translates it with the template; the hidden [data-gg-texts] divs carry
  the same strings (gg-builder.js reads them over the config "t"). Totals use the drawer's labels
  (aaroma.cart.*) and money_with_currency look.
{%- endcomment -%}
{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-builder.css' | asset_url | stylesheet_tag }}
<script>window.ggMoneyFormat = window.ggMoneyFormat || {{ shop.money_format | json }};</script>
<script src="{{ 'gg-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gg-builder.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign st = section.settings

  # Discount steps "min:percent" pairs, sorted as typed
  assign bb_steps_json = ''
  assign bb_steps = st.discount_steps | default: '2:25,4:30,6:35,8:40' | split: ','
  assign bb_first_min = 0
  assign bb_first_pct = 0
  for s in bb_steps
    assign sp = s | strip | split: ':'
    assign s_min = sp[0] | plus: 0
    assign s_pct = sp[1] | plus: 0
    if s_min < 1 or s_pct < 1
      continue
    endif
    if bb_steps_json != ''
      assign bb_steps_json = bb_steps_json | append: ','
    else
      assign bb_first_min = s_min
      assign bb_first_pct = s_pct
    endif
    assign bb_steps_json = bb_steps_json | append: '{"min":' | append: s_min | append: ',"pct":' | append: s_pct | append: '}'
  endfor

  # Pool collection: setting, else bestseller-singles, else all products
  assign bb_coll = st.pool_collection
  if bb_coll == blank
    assign bb_coll = collections['bestseller-singles']
  endif
  if bb_coll == blank
    assign bb_coll = collections.all
  endif
  assign bb_limit = st.pool_limit | default: 200 | plus: 0
  assign bb_size_tok = st.bottle_size | default: '50ml' | strip | downcase | remove: ' '
  assign bb_word = st.inspired_word | default: 'Inspired by'
  assign bb_anchor = st.anchor | default: 'build-your-own' | handleize
  assign bb_img = st.image
  if bb_img == blank and st.image_product != blank
    assign bb_img = st.image_product.featured_image
  endif

  # Gift packaging: first "gift_wrap" block with a product (a hidden gift wrap product)
  assign bb_wrap = blank
  assign bb_wrap_block = blank
  for block in section.blocks
    if block.type == 'gift_wrap' and block.settings.product != blank
      assign bb_wrap = block.settings.product.selected_or_first_available_variant
      assign bb_wrap_block = block
      break
    endif
  endfor

  # Every string the JS writes = a section setting (translated with the template), printed once below as hidden page
  # text and once in the config
  assign tx_number = st.number_label | default: 'No. [n]'
  assign tx_count = st.count_label | default: '[n] scents'
  assign tx_add = st.add_label | default: 'Add'
  assign tx_new = st.new_badge | default: 'New'
  assign tx_best = st.best_badge | default: 'Bestseller'
  assign tx_in_cart = st.in_cart_label | default: '[n] scents in your cart'
  assign tx_in_cart_one = st.in_cart_one_label | default: '1 scent in your cart'
  assign tx_start = st.start_label | default: 'Save [pct]% from [n] scents'
  assign tx_to_one = st.to_one_label | default: 'Add [n] more scent for [pct]% off'
  assign tx_to_many = st.to_many_label | default: 'Add [n] more scents for [pct]% off'
  assign tx_top = st.top_label | default: 'Top discount unlocked'
  assign tx_save = st.save_label | default: 'You save [amount]'
  assign tx_step = st.step_label | default: '[n] scents'
  assign tx_added = st.added_label | default: 'Added to your cart'
  assign tx_goal_gift = st.goal_gift_label | default: 'Mystery scent'
  assign tx_goal_ship = st.goal_ship_label | default: 'Free shipping'
  assign tx_to_gift = st.to_gift_label | default: '[amount] more for a mystery scent'
  assign tx_to_ship = st.to_ship_label | default: '[amount] more for free shipping'
  assign tx_goals_done = st.goals_done_label | default: 'All gifts unlocked'
  assign tx_remove = st.remove_label | default: 'Remove'
  assign tx_error = st.error | default: 'Something went wrong. Please try again.'
  assign tx_none = st.no_results | default: 'No scent found.'
  assign tx_more = st.show_more | default: 'Show [n] more scents'

  assign bb_status0 = tx_start | replace: '[n]', bb_first_min | replace: '[pct]', bb_first_pct
-%}

<div class="gg gg--surface-2 gg-bb" id="gg-{{ section.id }}">
  <span class="gg-anchor" id="{{ bb_anchor }}">&#8203;</span>
  <div class="gg__wrap">
    <div class="gg-head">
      {%- if st.eyebrow != blank -%}<span class="gg-eyebrow">{{ st.eyebrow | escape }}</span>{%- endif -%}
      {%- if st.heading != blank -%}<h2 class="gg-h2">{{ st.heading | escape }}</h2>{%- endif -%}
      {%- if st.text != blank -%}<p class="gg-sub">{{ st.text | escape }}</p>{%- endif -%}
    </div>

    <gg-builder class="gg-bb__card" data-section="{{ section.id }}">
      <script type="application/json" data-gg-config>
        {
          "steps": [{{ bb_steps_json }}],
          "pageSize": 12,
          "cartUrl": {{ routes.cart_url | json }},
          "moneyWithCurrency": {{ shop.money_with_currency_format | json }},
          "moneySample": {{ 123456789 | money | json }},
          "moneySampleCur": {{ 123456789 | money_with_currency | json }},
          "market": {{ localization.market.handle | json }},
          "wrap": {%- if bb_wrap != blank -%}{"variantId":"{{ bb_wrap.id }}","price":{{ bb_wrap.price }},"available":{{ bb_wrap.available }}}{%- else -%}null{%- endif -%},
          "qualify": [
            {%- assign bb_q_n = 0 -%}
            {%- assign bb_q_handles = st.discount_collections | default: 'all,bestseller-singles' | split: ',' -%}
            {%- for h in bb_q_handles -%}
              {%- assign qh = h | strip -%}
              {%- assign qc = collections[qh] -%}
              {%- if qc == blank -%}{%- continue -%}{%- endif -%}
              {%- paginate qc.products by 250 -%}
                {%- for qp in qc.products -%}
                  {%- if bb_q_n > 0 -%},{%- endif -%}{{ qp.id }}
                  {%- assign bb_q_n = bb_q_n | plus: 1 -%}
                {%- endfor -%}
              {%- endpaginate -%}
            {%- endfor -%}
          ],
          "t": {
            "number": {{ tx_number | json }},
            "inspired": {{ bb_word | json }},
            "count": {{ tx_count | json }},
            "add": {{ tx_add | json }},
            "isNew": {{ tx_new | json }},
            "best": {{ tx_best | json }},
            "inCart": {{ tx_in_cart | json }},
            "inCartOne": {{ tx_in_cart_one | json }},
            "start": {{ tx_start | json }},
            "toFirst": {{ tx_to_one | json }},
            "toFirstMany": {{ tx_to_many | json }},
            "toNext": {{ tx_to_one | json }},
            "toNextMany": {{ tx_to_many | json }},
            "top": {{ tx_top | json }},
            "save": {{ tx_save | json }},
            "added": {{ tx_added | json }},
            "goalGift": {{ tx_goal_gift | json }},
            "goalShip": {{ tx_goal_ship | json }},
            "toGift": {{ tx_to_gift | json }},
            "toShip": {{ tx_to_ship | json }},
            "goalsDone": {{ tx_goals_done | json }},
            "remove": {{ tx_remove | json }},
            "error": {{ tx_error | json }},
            "none": {{ tx_none | json }},
            "showMore": {{ tx_more | json }}
          }
        }
      </script>
      {%- comment -%}
        The same strings as page text, one string per div. gg-builder.js reads these over the config.
      {%- endcomment -%}
      <div hidden data-gg-texts>
        <div data-k="number">{{ tx_number | escape }}</div>
        <div data-k="inspired">{{ bb_word | escape }}</div>
        <div data-k="count">{{ tx_count | escape }}</div>
        <div data-k="add">{{ tx_add | escape }}</div>
        <div data-k="isNew">{{ tx_new | escape }}</div>
        <div data-k="best">{{ tx_best | escape }}</div>
        <div data-k="inCart">{{ tx_in_cart | escape }}</div>
        <div data-k="inCartOne">{{ tx_in_cart_one | escape }}</div>
        <div data-k="start">{{ tx_start | escape }}</div>
        <div data-k="toFirst">{{ tx_to_one | escape }}</div>
        <div data-k="toFirstMany">{{ tx_to_many | escape }}</div>
        <div data-k="toNext">{{ tx_to_one | escape }}</div>
        <div data-k="toNextMany">{{ tx_to_many | escape }}</div>
        <div data-k="top">{{ tx_top | escape }}</div>
        <div data-k="save">{{ tx_save | escape }}</div>
        <div data-k="added">{{ tx_added | escape }}</div>
        <div data-k="goalGift">{{ tx_goal_gift | escape }}</div>
        <div data-k="goalShip">{{ tx_goal_ship | escape }}</div>
        <div data-k="toGift">{{ tx_to_gift | escape }}</div>
        <div data-k="toShip">{{ tx_to_ship | escape }}</div>
        <div data-k="goalsDone">{{ tx_goals_done | escape }}</div>
        <div data-k="remove">{{ tx_remove | escape }}</div>
        <div data-k="error">{{ tx_error | escape }}</div>
        <div data-k="none">{{ tx_none | escape }}</div>
        <div data-k="showMore">{{ tx_more | escape }}</div>
      </div>
      <script type="application/json" data-gg-pool>
        [
        {%- comment -%}
          Pool = the main collection (bottle_size, max pool_limit, sorted by best-selling) + the extra collections
          (pool_extra "handle:size", e.g. black-utique:100ml), appended after it. A product in two collections shows once.
          Extra collections have no "Nr." in their titles: the card shows the name before " - " and the collection title under it.
        {%- endcomment -%}
        {%- assign bb_count = 0 -%}
        {%- assign bb_seen = ',' -%}
        {%- assign bb_fams = '|' -%}
        {%- assign bb_entries = bb_coll.handle | append: ':' | append: bb_size_tok -%}
        {%- if st.pool_extra != blank -%}{%- assign bb_entries = bb_entries | append: ',' | append: st.pool_extra -%}{%- endif -%}
        {%- assign bb_entries = bb_entries | split: ',' -%}
        {%- for bb_e in bb_entries -%}
          {%- assign bb_ep = bb_e | strip | split: ':' -%}
          {%- assign bb_h = bb_ep[0] | strip -%}
          {%- assign bb_pc = collections[bb_h] -%}
          {%- if bb_h == blank or bb_pc == blank -%}{%- continue -%}{%- endif -%}
          {%- assign bb_main = forloop.first -%}
          {%- assign bb_tok = bb_ep[1] | default: bb_size_tok | strip | downcase | remove: ' ' -%}
        {%- paginate bb_pc.products by 250 -%}
          {%- for p in bb_pc.products -%}
            {%- if bb_main and bb_count >= bb_limit -%}{%- break -%}{%- endif -%}
            {%- liquid
              assign skip = false
              if p.available == false or p.tags contains 'bundle' or p.has_only_default_variant
                assign skip = true
              endif
              assign p_key = ',' | append: p.id | append: ','
              if bb_seen contains p_key
                assign skip = true
              endif
              assign v = blank
              unless skip
                for pv in p.variants
                  assign pv_size = pv.title | downcase | remove: ' '
                  assign pv_head = pv_size | slice: 0, bb_tok.size
                  if pv.available and pv_head == bb_tok
                    assign v = pv
                    break
                  endif
                endfor
                if v == blank
                  assign skip = true
                endif
              endunless
            -%}
            {%- unless skip -%}
              {%- liquid
                # Gender = the product type, as the store's own builder (fmx-scent-bundle-builder-single genderBucket);
                # Unisex tag wins
                assign p_type = p.type | downcase | strip
                assign p_g = ''
                if p.tags contains 'Unisex' or p.tags contains 'unisex'
                  assign p_g = 'unisex'
                elsif p_type == 'voor mannen' or p_type == 'for men' or p_type == 'men' or p_type == 'pour homme' or p_type == 'pour les hommes' or p_type == 'für männer'
                  assign p_g = 'male'
                elsif p_type == 'voor vrouwen' or p_type == 'for women' or p_type == 'women' or p_type == 'pour femme' or p_type == 'pour les femmes' or p_type == 'für frauen'
                  assign p_g = 'female'
                endif

                # Bestseller badge = tag "bestseller" (main pool only); the JS lists these first, then the rest in
                # collection order
                assign p_best = false
                if bb_main and p.tags contains 'bestseller'
                  assign p_best = true
                endif
                assign p_new = false
                for t in p.tags
                  assign t_low = t | downcase | strip
                  if t_low == 'new' or t_low == 'neu' or t_low == 'new-arrival'
                    assign p_new = true
                  endif
                endfor

                assign p_fam = ''
                assign mf = p.metafields.custom.fragrance_family
                if mf != blank
                  if mf.type contains 'list.'
                    assign p_fam = mf.value | join: ', '
                  else
                    assign p_fam = mf.value | strip
                  endif
                endif
              -%}
              {%- capture bb_meta -%}{% render 'gg-scent-meta', product: p, variant: v, inspired_word: bb_word %}{%- endcapture -%}
              {%- assign bb_m = bb_meta | split: '~|~' -%}
              {%- liquid
                assign bb_n = bb_m[0] | default: '' | strip
                assign bb_t = p.title
                assign bb_s = ''
                unless bb_main
                  assign bb_n = ''
                  assign bb_t = p.title | split: ' - ' | first | strip
                  assign bb_s = bb_pc.title
                endunless
                assign bb_seen = bb_seen | append: p.id | append: ','
                assign p_fam_list = p_fam | split: ','
                for fam in p_fam_list
                  assign fam_c = fam | strip
                  assign fam_k = '|' | append: fam_c | append: '|'
                  if fam_c != blank
                    unless bb_fams contains fam_k
                      assign bb_fams = bb_fams | append: fam_c | append: '|'
                    endunless
                  endif
                endfor
              -%}
              {%- if bb_count > 0 -%},{%- endif -%}
              {"v":"{{ v.id }}","pid":{{ p.id }},"n":{{ bb_n | json }},"t":{{ bb_t | json }},"s":{{ bb_s | json }},"i":{{ bb_m[1] | default: '' | strip | json }},"o":{{ bb_m[2] | default: '' | strip | json }},"f":{{ p_fam | json }},"g":"{{ p_g }}","b":{{ p_best }},"w":{{ p_new }},"p":{{ v.price }},"img":{%- if p.featured_image != blank -%}{{ p.featured_image | image_url: width: 400 | json }}{%- else -%}""{%- endif -%},"c":{{ bb_m[4] | default: p.title | strip | json }}}
              {%- assign bb_count = bb_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        {%- endpaginate -%}
        {%- endfor -%}
        ]
      </script>
      {%- comment -%} Scent family names as page text for the filter pills (data-f = filter key) {%- endcomment -%}
      {%- assign bb_fam_list = bb_fams | split: '|' -%}
      <div hidden data-gg-fams>
        {%- for f in bb_fam_list -%}
          {%- if f != blank -%}<div data-f="{{ f | escape }}">{{ f | escape }}</div>{%- endif -%}
        {%- endfor -%}
      </div>

      <div class="gg-bb__top">
        <div class="gg-bb__media">
          {%- if bb_img != blank -%}
            {{ bb_img | image_url: width: 1400 | image_tag: widths: '400, 600, 800, 1000, 1200, 1400', sizes: '(min-width: 990px) 45vw, 100vw', loading: 'lazy', class: 'gg-bb__img', alt: bb_img.alt }}
          {%- elsif request.design_mode -%}
            <span class="gg-bb__img gg-bb__img--empty"></span>
          {%- endif -%}
        </div>

        <div class="gg-bb__sum" data-sum>
          <div class="gg-bb__sum-line">
            <span class="gg-bb__sum-title">{{ st.set_title | default: 'Your set' | escape }}</span>
            <span class="gg-bb__of" data-of>{{ tx_in_cart | replace: '[n]', '0' | escape }}</span>
          </div>

          {%- comment -%} Discount steps: one marker per step, the bar fills up to the bottles in the cart. Same markup again in the sticky bar. {%- endcomment -%}
          {%- capture bb_steps_html -%}
          <div class="gg-bb__steps" data-steps>
            <div class="gg-bb__steps-bar"><span class="gg-bb__steps-fill" data-steps-fill></span></div>
            <ol class="gg-bb__steps-list">
              {%- for s in bb_steps -%}
                {%- assign sp = s | strip | split: ':' -%}
                {%- assign s_min = sp[0] | plus: 0 -%}
                {%- assign s_pct = sp[1] | plus: 0 -%}
                {%- if s_min < 1 or s_pct < 1 -%}{%- continue -%}{%- endif -%}
                <li class="gg-bb__step-mark" data-step-min="{{ s_min }}">
                  <strong>-{{ s_pct }}%</strong>
                  <span>{{ tx_step | replace: '[n]', s_min | escape }}</span>
                </li>
              {%- endfor -%}
            </ol>
          </div>
          {%- endcapture -%}
          {{ bb_steps_html }}

          {%- comment -%} Kite goals (gifts + free shipping, cart total), same look; filled by JS from Kite's settings, hidden without Kite {%- endcomment -%}
          <div class="gg-bb__steps gg-bb__goals" data-goals hidden>
            <div class="gg-bb__steps-bar"><span class="gg-bb__steps-fill" data-goals-fill></span></div>
            <ol class="gg-bb__steps-list" data-goals-list></ol>
          </div>

          <p class="gg-bb__status" data-status aria-live="polite">{{ bb_status0 | escape }}</p>
          <p class="gg-bb__status gg-bb__goal-status" data-goal-status aria-live="polite" hidden></p>
          <p class="gg-bb__saving" data-saving hidden></p>

          <div class="gg-bb__picked" role="list" data-picked hidden></div>
          <div class="gg-bb__addons" role="list" data-addons hidden></div>

          {%- if bb_wrap != blank and bb_wrap.available -%}
            <label class="gg-bb__wrap" {{ bb_wrap_block.shopify_attributes }}>
              <input class="gg-bb__wrap-input" type="checkbox" data-wrap>
              <span class="gg-bb__wrap-switch" aria-hidden="true"></span>
              <span class="gg-bb__wrap-txt">
                <a class="gg-bb__wrap-title" href="{{ bb_wrap_block.settings.product.url }}" target="_blank" rel="noopener">{{ bb_wrap_block.settings.label | default: 'Gift wrap it' | escape }}</a>
                {%- if bb_wrap_block.settings.text != blank -%}
                  <span class="gg-bb__wrap-sub">{{ bb_wrap_block.settings.text | escape }}</span>
                {%- endif -%}
              </span>
              <span class="gg-bb__wrap-price">+{{ bb_wrap.price | money_without_trailing_zeros }}</span>
            </label>
          {%- endif -%}

          {%- comment -%} Shipping protection: the Insureful switch of the cart drawer, mirrored. Insureful stores the choice and adds its
             product at checkout; the checkout button below does the same. The drawer only renders the switch once the cart
             has items, so the row stays hidden until it exists (re-checked after every cart change). {%- endcomment -%}
          <label class="gg-bb__wrap gg-bb__ins" data-ins-row hidden>
            <input class="gg-bb__wrap-input" type="checkbox" data-ins>
            <span class="gg-bb__wrap-switch" aria-hidden="true"></span>
            <span class="gg-bb__wrap-txt">
              <span class="gg-bb__wrap-title gg-bb__ins-title" data-ins-title>{{ st.ins_title | default: 'Shipping protection' | escape }}</span>
              <span class="gg-bb__wrap-sub" data-ins-sub>{{ st.ins_text | default: 'Protects your order against loss and damage.' | escape }}</span>
            </span>
            <span class="gg-bb__wrap-price" data-ins-price></span>
          </label>

          {%- comment -%} Totals as the cart drawer shows them (snippets/cart-drawer.liquid): same labels and saving class {%- endcomment -%}
          <div class="gg-bb__totals" data-totals hidden>
            <div class="gg-bb__tot" data-tot-sub-row>
              <span>{{ 'aaroma.cart.subtotal' | t }}</span>
              <span data-tot-sub></span>
            </div>
            <div class="gg-bb__tot" data-tot-off-row>
              <span>{{ 'aaroma.cart.discount' | t }}</span>
              <span class="pm-cart-drawer__saving" data-tot-off></span>
            </div>
            <div class="gg-bb__tot gg-bb__tot--total">
              <span>{{ 'aaroma.cart.total' | t }}</span>
              <span data-tot-total></span>
            </div>
          </div>

          <p class="gg-bb__added" role="status" aria-live="polite" data-bb-added hidden></p>
          <button type="button" class="gg-btn gg-btn--primary gg-btn--block gg-bb__cta" data-cta disabled>{{ st.checkout_label | default: 'Checkout' | escape }}</button>
          <p class="gg-bb__err" role="alert" data-err hidden></p>
          {%- if st.fine_print != blank -%}<p class="gg-bb__fine">{{ st.fine_print | escape }}</p>{%- endif -%}
          {%- comment -%} Same trust pair as the store's FM buy box (fmx-variant-selector) {%- endcomment -%}
          <div class="gg-bb__trust">
            {% render 'fmx-payment-icons' %}
            {% render 'fmx-shipping-badges' %}
          </div>
        </div>
      </div>

      <div class="gg-bb__pick">
        <div class="gg-bb__filters">
          {%- capture bb_chips -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'preset' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign pp = block.settings.product
                assign pp_ids = ''
                if pp != blank
                  for fv in pp.metafields.custom.fixed_bundle_products.value
                    if fv.id != blank
                      if pp_ids != ''
                        assign pp_ids = pp_ids | append: ','
                      endif
                      assign pp_ids = pp_ids | append: '"' | append: fv.id | append: '"'
                    endif
                  endfor
                endif
                assign pp_label = block.settings.label
                if pp_label == blank and pp != blank
                  assign pp_label = pp.metafields.custom.gift_title.value | default: pp.title
                endif
                assign pp_v = blank
                if pp != blank
                  assign pp_v = pp.selected_or_first_available_variant
                endif
              -%}
              {%- if pp_ids != '' and pp_v != blank and pp_v.available -%}
                {%- comment -%} Fair value = the set's 50 ml bottles at their single prices (bought separately) {%- endcomment -%}
                {%- assign pp_fair = 0 -%}
                {%- for fv in pp.metafields.custom.fixed_bundle_products.value -%}
                  {%- assign pp_fair = pp_fair | plus: fv.price -%}
                {%- endfor -%}
                {%- if pp_fair <= pp_v.price -%}{%- assign pp_fair = 0 -%}{%- endif -%}
                {%- capture pp_names -%}
                  [
                  {%- for fv in pp.metafields.custom.fixed_bundle_products.value -%}
                    {%- capture pp_meta -%}{% render 'gg-scent-meta', product: fv.product, variant: fv, inspired_word: bb_word %}{%- endcapture -%}
                    {%- assign pp_m = pp_meta | split: '~|~' -%}
                    {"id":{{ fv.id | json }},"name":{{ pp_m[4] | default: fv.product.title | strip | json }}}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                  ]
                {%- endcapture -%}
                <button type="button" class="gg-bb__chip" data-set-variant="{{ pp_v.id }}" data-set-price="{{ pp_v.price }}" data-set-compare="{{ pp_fair }}" data-set-title="{{ pp_label | escape }}" data-set-scents="{{ pp_names | strip | escape }}" aria-pressed="false" {{ block.shopify_attributes }}><span class="gg-bb__chip-ok" aria-hidden="true">✓</span><span>{{ pp_label | escape }}</span><span class="gg-bb__chip-price">+{{ pp_v.price | money_without_trailing_zeros }}{%- if pp_fair > 0 -%}{{ ' ' }}<s>{{ pp_fair | money_without_trailing_zeros }}</s>{%- endif -%}</span></button>
              {%- elsif request.design_mode -%}
                <button type="button" class="gg-bb__chip" disabled {{ block.shopify_attributes }}>{{ pp_label | default: 'Choose a gift set' | escape }}</button>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if bb_chips != blank -%}
            <div class="gg-bb__group gg-bb__group--presets">
              <p class="gg-bb__label" id="ggbb-pre-{{ section.id }}">{{ st.presets_label | escape }}</p>
              <div class="gg-bb__scroller gg-bb__chips" role="group" aria-labelledby="ggbb-pre-{{ section.id }}">
                {{- bb_chips -}}
              </div>
              {%- if st.presets_note != blank -%}<p class="gg-bb__note">{{ st.presets_note | escape }}</p>{%- endif -%}
            </div>
          {%- endif -%}

          <div class="gg-bb__group" data-g-group>
            <p class="gg-bb__label" id="ggbb-g-{{ section.id }}">{{ st.gender_label | escape }}</p>
            <div class="gg-bb__scroller gg-bb__opts" role="group" aria-labelledby="ggbb-g-{{ section.id }}">
              <button type="button" class="gg-bb__opt is-active" data-g="all" aria-pressed="true"><span>{{ st.gender_all | escape }}</span> <span class="gg-bb__cnt" data-cnt="all"></span></button>
              <button type="button" class="gg-bb__opt" data-g="unisex" aria-pressed="false"><span>{{ st.gender_unisex | escape }}</span> <span class="gg-bb__cnt" data-cnt="unisex"></span></button>
              <button type="button" class="gg-bb__opt" data-g="male" aria-pressed="false"><span>{{ st.gender_male | escape }}</span> <span class="gg-bb__cnt" data-cnt="male"></span></button>
              <button type="button" class="gg-bb__opt" data-g="female" aria-pressed="false"><span>{{ st.gender_female | escape }}</span> <span class="gg-bb__cnt" data-cnt="female"></span></button>
            </div>
          </div>

          <div class="gg-bb__group" data-f-group>
            <p class="gg-bb__label" id="ggbb-f-{{ section.id }}">{{ st.family_label | escape }}</p>
            <div class="gg-bb__scroller gg-bb__pills" role="group" aria-labelledby="ggbb-f-{{ section.id }}" data-f-list>
              <button type="button" class="gg-bb__pill is-active" data-f="" aria-pressed="true">{{ st.gender_all | escape }}</button>
            </div>
          </div>

          <div class="gg-bb__group gg-bb__group--search">
            <label class="gg-vh" for="ggbb-q-{{ section.id }}">{{ st.search_placeholder | escape }}</label>
            <div class="gg-bb__search">
              <svg class="gg-bb__search-ico" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <input class="gg-bb__input" type="search" id="ggbb-q-{{ section.id }}" placeholder="{{ st.search_placeholder | escape }}" autocomplete="off" data-q>
            </div>
          </div>
        </div>

        <div class="gg-bb__main">
          <div class="gg-bb__listhead">
            <p class="gg-bb__count" data-count aria-live="polite"></p>
            <p class="gg-bb__sort">{{ st.sort_label | escape }}</p>
          </div>
          <div class="gg-bb__list" role="list" data-list tabindex="-1"></div>
          <button type="button" class="gg-btn gg-bb__more" data-more hidden></button>
        </div>
      </div>

      {%- comment -%} Sticky bar: shown while the builder is on screen and the box is not {%- endcomment -%}
      <div class="gg-bb__bar" data-bar hidden>
        <p class="gg-bb__added gg-bb__bar-added" aria-hidden="true" data-bb-added hidden></p>
        <div class="gg-bb__bar-in">
          <div class="gg-bb__bar-steps">{{ bb_steps_html }}</div>
          <button type="button" class="gg-bb__bar-cart" data-bar-cta aria-label="{{ st.cta | default: 'Go to cart' | escape }}" disabled>
            {%- comment -%} Same bag icon as the header cart (sections/header.liquid) {%- endcomment -%}
            {%- render 'pm-icon', icon: 'bag', size: 24, stroke: 1.5, class: 'icon icon-cart' -%}
            <span class="gg-bb__bar-badge" data-bar-badge hidden>0</span>
          </button>
        </div>
      </div>
    </gg-builder>
  </div>
</div>

{% schema %}
{
  "name": "GG Set builder",
  "tag": "section",
  "class": "gg-section pm-scope",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor (without #)",
      "default": "build-your-own"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Build your own"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your own set"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image left"
    },
    {
      "type": "product",
      "id": "image_product",
      "label": "Image from product",
      "info": "Used when no image is chosen."
    },
    {
      "type": "header",
      "content": "Quantity discount"
    },
    {
      "type": "paragraph",
      "content": "The discount comes from the automatic discounts in Shopify. This only shows it: steps and collections must match those discounts."
    },
    {
      "type": "text",
      "id": "discount_steps",
      "label": "Steps (count:percent)",
      "default": "2:25,4:30,6:35,8:40"
    },
    {
      "type": "text",
      "id": "discount_collections",
      "label": "Discount collections (handles)",
      "default": "all,bestseller-singles"
    },
    {
      "type": "text",
      "id": "checkout_label",
      "label": "Checkout button",
      "default": "Checkout"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Note after adding",
      "default": "Added to your cart"
    },
    {
      "type": "text",
      "id": "goal_gift_label",
      "label": "Kite: gift name",
      "default": "Mystery scent"
    },
    {
      "type": "text",
      "id": "goal_ship_label",
      "label": "Kite: shipping name",
      "default": "Free shipping"
    },
    {
      "type": "header",
      "content": "Scent pool"
    },
    {
      "type": "collection",
      "id": "pool_collection",
      "label": "Collection",
      "info": "Empty: bestseller-singles, then all products. Scents tagged bestseller get the badge and are listed first, the rest follow in collection order."
    },
    {
      "type": "range",
      "id": "pool_limit",
      "label": "Max. scents",
      "min": 50,
      "max": 250,
      "step": 2,
      "default": 200
    },
    {
      "type": "text",
      "id": "bottle_size",
      "label": "Bottle size (variant)",
      "default": "50ml"
    },
    {
      "type": "text",
      "id": "pool_extra",
      "label": "More collections (handle:size)",
      "default": "black-utique:100ml",
      "info": "Comma-separated, e.g. black-utique:100ml,intense:50ml. Added after the collection above. For the discount, also list them under discount collections."
    },
    {
      "type": "text",
      "id": "inspired_word",
      "label": "Inspired word",
      "default": "Inspired by"
    },
    {
      "type": "text",
      "id": "number_label",
      "label": "Scent number",
      "info": "[n] = number.",
      "default": "No. [n]"
    },
    {
      "type": "header",
      "content": "Filters"
    },
    {
      "type": "text",
      "id": "presets_label",
      "label": "Gift sets title",
      "default": "Add a ready-made gift set"
    },
    {
      "type": "textarea",
      "id": "presets_note",
      "label": "Gift sets note",
      "default": "Already discounted, added to your cart as a set of its own."
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search",
      "default": "No., name or note"
    },
    {
      "type": "text",
      "id": "gender_label",
      "label": "For whom",
      "default": "For whom"
    },
    {
      "type": "text",
      "id": "gender_all",
      "label": "All (for whom, scent family)",
      "default": "All"
    },
    {
      "type": "text",
      "id": "gender_unisex",
      "label": "Unisex",
      "default": "Unisex"
    },
    {
      "type": "text",
      "id": "gender_male",
      "label": "Men",
      "default": "Men"
    },
    {
      "type": "text",
      "id": "gender_female",
      "label": "Women",
      "default": "Women"
    },
    {
      "type": "text",
      "id": "family_label",
      "label": "Scent family",
      "default": "Scent family"
    },
    {
      "type": "header",
      "content": "List"
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count",
      "info": "[n] = number of scents.",
      "default": "[n] scents"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sorting",
      "default": "Bestsellers first"
    },
    {
      "type": "text",
      "id": "add_label",
      "label": "Add",
      "default": "Add"
    },
    {
      "type": "text",
      "id": "new_badge",
      "label": "Badge new",
      "default": "New"
    },
    {
      "type": "text",
      "id": "best_badge",
      "label": "Badge bestseller",
      "default": "Bestseller"
    },
    {
      "type": "text",
      "id": "no_results",
      "label": "No results",
      "default": "No scent found."
    },
    {
      "type": "text",
      "id": "show_more",
      "label": "Show more",
      "info": "[n] = number of scents.",
      "default": "Show [n] more scents"
    },
    {
      "type": "header",
      "content": "Your set"
    },
    {
      "type": "text",
      "id": "set_title",
      "label": "Title",
      "default": "Your set"
    },
    {
      "type": "text",
      "id": "in_cart_label",
      "label": "Scents in cart",
      "info": "[n] = number of scents.",
      "default": "[n] scents in your cart"
    },
    {
      "type": "text",
      "id": "in_cart_one_label",
      "label": "One scent in cart",
      "default": "1 scent in your cart"
    },
    {
      "type": "text",
      "id": "step_label",
      "label": "Step under each discount",
      "info": "[n] = number of scents.",
      "default": "[n] scents"
    },
    {
      "type": "text",
      "id": "start_label",
      "label": "Status: empty",
      "info": "[n] = scents of the first step, [pct] = its discount.",
      "default": "Save [pct]% from [n] scents"
    },
    {
      "type": "text",
      "id": "to_one_label",
      "label": "Status: one scent to the next step",
      "info": "[n] = scents to go, [pct] = next discount.",
      "default": "Add [n] more scent for [pct]% off"
    },
    {
      "type": "text",
      "id": "to_many_label",
      "label": "Status: scents to the next step",
      "info": "[n] = scents to go, [pct] = next discount.",
      "default": "Add [n] more scents for [pct]% off"
    },
    {
      "type": "text",
      "id": "top_label",
      "label": "Status: top step reached",
      "default": "Top discount unlocked"
    },
    {
      "type": "text",
      "id": "save_label",
      "label": "Saving",
      "info": "[amount] = saving.",
      "default": "You save [amount]"
    },
    {
      "type": "text",
      "id": "to_gift_label",
      "label": "Kite: to the gift",
      "info": "[amount] = amount to go.",
      "default": "[amount] more for a mystery scent"
    },
    {
      "type": "text",
      "id": "to_ship_label",
      "label": "Kite: to free shipping",
      "info": "[amount] = amount to go.",
      "default": "[amount] more for free shipping"
    },
    {
      "type": "text",
      "id": "goals_done_label",
      "label": "Kite: all reached",
      "default": "All gifts unlocked"
    },
    {
      "type": "text",
      "id": "remove_label",
      "label": "Remove (screen readers)",
      "default": "Remove"
    },
    {
      "type": "text",
      "id": "ins_title",
      "label": "Shipping protection title",
      "info": "Shown until the Insureful widget's own text loads.",
      "default": "Shipping protection"
    },
    {
      "type": "text",
      "id": "ins_text",
      "label": "Shipping protection text",
      "default": "Protects your order against loss and damage."
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Cart button (sticky bar, screen readers)",
      "default": "Go to cart"
    },
    {
      "type": "text",
      "id": "error",
      "label": "Error",
      "default": "Something went wrong. Please try again."
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "Fine print"
    }
  ],
  "blocks": [
    {
      "type": "preset",
      "name": "Gift set",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Gift set",
          "info": "Fixed set: the scents come from custom.fixed_bundle_products."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "info": "Empty: custom.gift_title, then the product title."
        }
      ]
    },
    {
      "type": "gift_wrap",
      "name": "Gift wrap",
      "limit": 1,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Its own cart line when the switch is on."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Title",
          "default": "Gift wrap it"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Note"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GG Set builder",
      "blocks": [
        {
          "type": "preset"
        },
        {
          "type": "preset"
        }
      ]
    }
  ]
