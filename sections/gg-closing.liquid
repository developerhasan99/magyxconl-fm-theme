{{ 'gg-base.css' | asset_url | stylesheet_tag }}
{{ 'gg-sections.css' | asset_url | stylesheet_tag }}
<div class="gg gg-close gg--surface" id="gg-{{ section.id }}">
  {%- if section.settings.anchor != blank -%}
    <span class="gg-anchor" id="{{ section.settings.anchor | handleize }}">&#8203;</span>
  {%- endif -%}
  <div class="gg__wrap gg__wrap--narrow gg-close__wrap">
    {%- if section.settings.heading != blank -%}
      <h2 class="gg-h2 gg-close__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.sub != blank -%}
      <p class="gg-sub gg-close__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="gg-btn gg-btn--primary gg-close__btn" href="{{ section.settings.button_link | default: '#for-her' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.guarantee != blank -%}
      <p class="gg-small gg-close__guarantee">{{ section.settings.guarantee | escape }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "GG Closing",
  "tag": "section",
  "class": "gg-section pm-scope",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID (optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gifts sorted, with time to breathe."
    },
    {
      "type": "textarea",
      "id": "sub",
      "label": "Subtitle",
      "default": "Pick a set, we take care of the rest."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "See the gift sets"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link (also #anchor)",
      "default": "#for-her"
    },
    {
      "type": "text",
      "id": "guarantee",
      "label": "Guarantee line",
      "default": "60-day money-back guarantee."
    }
  ],
  "presets": [
    {
      "name": "GG Closing"
    }
  ]
}
{% endschema %}
