{%- comment -%}
  Review wall (masonry, load more). FM parity 04.11.2026: on the homepage it renders the FM review wall of
  magicperfume.co / tryscent.co (markup of sections/pm-bs-massive-review.liquid, layout CSS
  assets/pm-s-bs-massive-review.css, cards .pm-review from pm-sections.css): heading + stars line, white cards with a
  1px line, ink text, green stars, product row. Same blocks, settings and reviews as before; other templates keep
  the old look below.
{%- endcomment -%}
{%- liquid
  assign pm_mr_fm = false
  if template.name == 'index'
    assign pm_mr_fm = true
  endif
-%}
{%- if pm_mr_fm -%}
{{ 'pm-s-bs-massive-review.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .premium .pm-reviews--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-reviews--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="{{ section.id }}" class="pm-scope pm-reviews pm-reviews--{{ section.id }} color-scheme-1 gradient">
  <div class="page-width">
    <div class="pm-reviews__head">
      <h2 class="pm-h2 pm-reviews__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.review_text != blank -%}
        <div class="pm-reviews__rating">
          {% render 'pm-stars', rating: 4.7, size: 12 %}
          <span class="pm-small pm-muted">{{ section.settings.review_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div id="reviews-source-{{ section.id }}" class="hidden">
      {%- for block in section.blocks -%}
        {%- assign rating = block.settings.rating | default: 5 | plus: 0 -%}
        {%- liquid
          assign pm_mr_img = block.settings.review_image
          assign pm_mr_url = ''
          assign pm_mr_w = ''
          assign pm_mr_h = ''
          if pm_mr_img == blank and block.settings.review_image_url != blank
            assign pm_mr_parts = block.settings.review_image_url | split: '#'
            assign pm_mr_frag = pm_mr_parts[1] | default: '' | split: '|'
            assign pm_mr_file = pm_mr_frag[0] | default: ''
            assign pm_mr_dims = pm_mr_frag[1] | default: '' | split: 'x'
            assign pm_mr_w = pm_mr_dims[0] | default: ''
            assign pm_mr_h = pm_mr_dims[1] | default: ''
            if pm_mr_file != '' and images[pm_mr_file] != blank
              assign pm_mr_img = images[pm_mr_file]
            else
              assign pm_mr_url = pm_mr_parts[0]
            endif
          endif
        -%}
        <article
          class="review-item pm-review"
          data-review-index="{{ forloop.index }}"
          {{ block.shopify_attributes }}>
          {%- if pm_mr_img != blank -%}
            <img
              class="pm-review__img"
              src="{{ pm_mr_img | image_url: width: 540 }}"
              srcset="{{ pm_mr_img | image_url: width: 360 }} 360w, {{ pm_mr_img | image_url: width: 540 }} 540w, {{ pm_mr_img | image_url: width: 720 }} 720w"
              sizes="(min-width: 990px) 360px, (min-width: 750px) 45vw, 90vw"
              alt="{{ pm_mr_img.alt | escape }}"
              width="{{ pm_mr_img.width }}"
              height="{{ pm_mr_img.height }}"
              loading="lazy">
          {%- elsif pm_mr_url != blank -%}
            <img class="pm-review__img" src="{{ pm_mr_url }}" alt="" width="{{ pm_mr_w | default: 800 }}" height="{{ pm_mr_h | default: 1000 }}" loading="lazy">
          {%- endif -%}
          <div class="pm-review__body">
            <div class="pm-review__meta">
              <div class="pm-review__who">
                {%- if block.settings.author_image != blank -%}
                  <img
                    class="pm-review__avatar"
                    src="{{ block.settings.author_image | image_url: width: 64, height: 64 }}"
                    alt=""
                    width="32"
                    height="32"
                    loading="lazy">
                {%- endif -%}
                <div>
                  <p class="pm-review__name">{{ block.settings.author }}</p>
                  {%- if block.settings.show_verified_badge -%}
                    <span class="pm-review__verified">{% render 'pm-icon', icon: 'check', size: 12, stroke: 2 %}{{ 'aaroma.common.verified_buyer' | t }}</span>
                  {%- endif -%}
                </div>
              </div>
              <div class="pm-review__rating">
                <span class="pm-review__stars" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating, rating_max: 5 }}">
                  {%- for i in (1..5) -%}
                    <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                  {%- endfor -%}
                </span>
                {%- if block.settings.date != blank -%}
                  <span class="pm-review__date">{{ block.settings.date }}</span>
                {%- endif -%}
              </div>
            </div>
            <div class="pm-review__text rte">
              {{ block.settings.content }}
            </div>
            {%- if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}" class="pm-review__product">
                <img
                  src="{{ block.settings.product.featured_image | image_url: width: 64, height: 64 }}"
                  alt="{{ block.settings.product.title | escape }}"
                  width="32"
                  height="32"
                  loading="lazy">
                <div>
                  <p class="pm-review__product-title">{{ block.settings.product.title }}</p>
                  {%- assign inspiration = block.settings.product.metafields.custom.inspiration -%}
                  {%- if inspiration != blank -%}
                    {%- assign inspiration_name = inspiration.value.name | default: inspiration.value -%}
                    <p class="pm-review__product-meta">{{ 'aaroma.bundle.f_inspired_by' | t }} {{ inspiration_name }}</p>
                  {%- endif -%}
                </div>
              </a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    <div
      id="reviews-container-{{ section.id }}"
      class="masonry-grid masonry-container pm-reviews__grid"
      data-pm-cols-desktop="3"
      data-pm-cols-mobile="2"></div>

    <div id="load-more-container-{{ section.id }}" class="pm-reviews__more {% if section.blocks.size <= 20 %}hidden{% endif %}">
      <button id="load-more-btn-{{ section.id }}" type="button" class="pm-btn pm-btn--secondary">
        {{ 'aaroma.misc.show_more_reviews' | t }}
      </button>
      <div id="loading-spinner-{{ section.id }}" class="hidden pm-reviews__loading">
        <div class="loading-spinner pm-reviews__spinner"></div>
        <span class="pm-small pm-muted">{{ 'aaroma.misc.loading_reviews' | t }}</span>
      </div>
    </div>
  </div>
</div>
{%- else -%}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .review-item {
    opacity: 0;
    animation: fadeIn 0.5s ease-in forwards;
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .loading-spinner {
    border: 3px solid #f3f4f6;
    border-top: 3px solid #1f2937;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .hidden {
    display: none;
  }

  .masonry-container {
    position: relative;
  }

  .masonry-column {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .masonry-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    align-items: start;
  }

  @media screen and (min-width: 1024px) {
    .masonry-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-bold text-slate-900 my-0">{{ section.settings.heading }}</h2>
      <div class="flex flex-wrap justify-end text-right items-center gap-2">
        <img
          src="{{ 'rating-stars.svg' |  asset_url }}"
          alt="*****"
          width="80"
          height="16">
        <span class="text-sm font-medium text-slate-600">{{ section.settings.review_text }}</span>
      </div>
    </div>

    <div id="reviews-source-{{ section.id }}" class="hidden">
      {% for block in section.blocks %}
        <div
          class="review-item rounded-lg bg-white border border-solid border-gray-100 overflow-hidden"
          data-review-index="{{ forloop.index }}"
          {{ block.shopify_attributes }}>
          {% if block.settings.review_image != blank %}
            <img
              class="w-full h-auto rounded-t-lg"
              src="{{ block.settings.review_image | image_url: width: 360 }}"
              alt="{{ block.settings.review_image.alt }}"
              width="360"
              height="360">
          {% endif %}
          <div class="p-2 md:p-4">
            <div class="flex flex-wrap gap-2 justify-between">
              <div class="flex items-center gap-3">
                {% if block.settings.author_image != blank %}
                  <img
                    class="size-10 rounded-full [display:none] md:block flex-1"
                    src="{{ block.settings.author_image |  image_url: width: 40, height: 40 }}"
                    alt="{{ block.settings.author }}"
                    width="40"
                    height="40">
                {% endif %}

                <div class="flex flex-col gap-1">
                  <p class="text-base font-bold text-slate-900 my-0">{{ block.settings.author | default: "Alex Thompson" }}</p>
                  {% if block.settings.show_verified_badge %}
                    <div class="flex items-center gap-1 text-xs text-[#297af4] font-medium">
                      <img
                        src="{{ 'verified-badge.svg' | asset_url }}"
                        alt="Verified Buyer"
                        width="16"
                        height="16"
                        loading="lazy">
                      {{ 'aaroma.common.verified_buyer' | t }}
                    </div>
                  {% endif %}
                </div>
              </div>
              <div class="flex flex-col md:items-end gap-1">
                <div class="flex leading-none">
                  {% assign rating = block.settings.rating | default: 5 | plus: 0 %}
                  {% assign empty_stars = 5 | minus: rating %}

                  {% for i in (1..rating) %}
                    <span class="text-[#ffc109]">★</span>
                  {% endfor %}

                  {% for i in (1..empty_stars) %}
                    <span class="text-gray-400">★</span>
                  {% endfor %}
                </div>

                <div class="text-xs text-gray-400">{{ block.settings.date }}</div>
              </div>
            </div>
            <div class="text-slate-600 text-sm leading-relaxed">
              {{ block.settings.content }}
            </div>
            {% if block.settings.product != blank %}
              <div class="border-0 border-t border-solid border-gray-100 pt-2">
                <a href="{{ block.settings.product.url }}" class="flex items-center gap-3 no-underline text-black">
                  <img
                    class="size-8 rounded"
                    src="{{ block.settings.product.images.first |  image_url: width: 32, height: 32 }}"
                    alt="{{ block.settings.product.title }}"
                    width="32"
                    height="32">

                  <div class="flex flex-col">
                    <p class="text-sm font-bold text-slate-900 my-0 line-clamp-2 md:line-clamp-1">{{ block.settings.product.title }}</p>
                    <div class="text-xs [display:none] md:block">{{ 'aaroma.bundle.f_inspired_by' | t }} {{ block.settings.product.metafields.custom.inspiration.value.name }}</div>
                  </div>
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    <div id="reviews-container-{{ section.id }}" class="masonry-grid masonry-container"></div>

    <div id="load-more-container-{{ section.id }}" class="mt-12 text-center {% if section.blocks.size <= 20 %}hidden{% endif %}">
      <button id="load-more-btn-{{ section.id }}" class="px-5 py-2 border border-solid border-gray-400 rounded-lg text-slate-900 font-bold text-sm uppercase tracking-wide bg-white hover:bg-slate-900 hover:text-white transition-colors cursor-pointer">
        {{ 'aaroma.misc.show_more_reviews' | t }}
      </button>
      <div id="loading-spinner-{{ section.id }}" class="hidden flex items-center justify-center gap-2 mt-4">
        <div class="loading-spinner"></div>
        <span class="text-sm text-slate-600">{{ 'aaroma.misc.loading_reviews' | t }}</span>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

<script>
  (function() {
  const sectionId = '{{ section.id }}';
  const btn = document.getElementById(`load-more-btn-${sectionId}`);
  const spinner = document.getElementById(`loading-spinner-${sectionId}`);
  const container = document.getElementById(`reviews-container-${sectionId}`);
  const sourceContainer = document.getElementById(`reviews-source-${sectionId}`);
  const loadMoreContainer = document.getElementById(`load-more-container-${sectionId}`);
  
  let currentlyShowing = 0;
  const totalReviews = {{ section.blocks.size }};
  const initialLoad = 20;
  
  let columns = [];
  let columnHeights = [];
  let numColumns = window.innerWidth >= {% if pm_mr_fm %}990{% else %}1024{% endif %} ? 3 : 2;

  // Initialize columns
  function initColumns() {
    container.innerHTML = '';
    columns = [];
    columnHeights = [];
    numColumns = window.innerWidth >= {% if pm_mr_fm %}990{% else %}1024{% endif %} ? 3 : 2;
    
    for (let i = 0; i < numColumns; i++) {
      const col = document.createElement('div');
      col.className = 'masonry-column';
      container.appendChild(col);
      columns.push(col);
      columnHeights.push(0);
    }
  }

  // Get shortest column index
  function getShortestColumnIndex() {
    let minHeight = columnHeights[0];
    let minIndex = 0;
    
    for (let i = 1; i < columnHeights.length; i++) {
      if (columnHeights[i] < minHeight) {
        minHeight = columnHeights[i];
        minIndex = i;
      }
    }
    
    return minIndex;
  }

  // Add reviews to masonry layout
  function addReviews(count) {
    const allReviews = sourceContainer.querySelectorAll('.review-item');
    const end = Math.min(currentlyShowing + count, totalReviews);
    
    for (let i = currentlyShowing; i < end; i++) {
      if (allReviews[i]) {
        const clone = allReviews[i].cloneNode(true);
        clone.style.opacity = '0';
        
        // Get the shortest column
        const shortestIndex = getShortestColumnIndex();
        columns[shortestIndex].appendChild(clone);
        
        // Force a reflow to get accurate height
        clone.offsetHeight;
        
        // Update the height tracking (approximate)
        const cardHeight = clone.offsetHeight || 300; // fallback height
        columnHeights[shortestIndex] += cardHeight + 12; // 12px is the gap
        
        // Trigger fade in
        setTimeout(() => {
          clone.style.opacity = '';
        }, 10);
      }
    }
    
    currentlyShowing = end;
    
    // Recalculate actual heights after all cards are added
    setTimeout(() => {
      for (let i = 0; i < columns.length; i++) {
        columnHeights[i] = columns[i].offsetHeight;
      }
    }, 100);
  }

  // Handle window resize
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      const newNumColumns = window.innerWidth >= {% if pm_mr_fm %}990{% else %}1024{% endif %} ? 3 : 2;
      if (newNumColumns !== numColumns) {
        const tempShowing = currentlyShowing;
        currentlyShowing = 0;
        initColumns();
        addReviews(tempShowing);
      }
    }, 250);
  });

  // Initial load
  initColumns();
  addReviews(initialLoad);

  // Load more button
  if (btn) {
    btn.addEventListener('click', function() {
      btn.classList.add('hidden');
      spinner.classList.remove('hidden');

      setTimeout(function() {
        addReviews(10);
        
        spinner.classList.add('hidden');

        if (currentlyShowing < totalReviews) {
          btn.classList.remove('hidden');
        } else {
          loadMoreContainer.classList.add('hidden');
        }

        // Smooth scroll
        // const allCards = container.querySelectorAll('.review-item');
        // if (allCards[currentlyShowing - 10]) {
        //   setTimeout(() => {
        //     allCards[currentlyShowing - 10].scrollIntoView({ 
        //       behavior: 'smooth', 
        //       block: 'nearest' 
        //     });
        //   }, 100);
        // }
      }, 800);
    });
  }
  })();
</script>

{% schema %}
  {
    "name": "Massive Review",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Customer Reviews"
      },
      {
        "type": "text",
        "id": "review_text",
        "label": "Review Text",
        "default": "4.9/5 based on 2,400+ reviews"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text",
        "default": "Read all reviews"
      }, {
        "type": "url",
        "id": "button_link",
        "label": "Button Link",
        "default": "/collections/all"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "review",
        "name": "Review",
        "settings": [
          {
            "type": "image_picker",
            "id": "review_image",
            "label": "Review Image"
          },
          {
            "type": "url",
            "id": "review_image_url",
            "label": "Review image URL (Judge.me)",
            "info": "Used when Review Image is empty. After the URL: #filename|widthxheight. The filename names the copy in Files (docs/reviews/upload_photos.py); once that file exists it is used instead of the URL."
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "Review Content",
            "default": "<p>\"The fit is exactly what I was looking for. Shipping was incredibly fast, arrived in 2 days.\"</p>"
          },
          {
            "type": "text",
            "id": "author",
            "label": "Author Name",
            "default": "Alex Thompson"
          },
          {
            "type": "image_picker",
            "id": "author_image",
            "label": "Author Image"
          }, {
            "type": "text",
            "id": "date",
            "label": "Date",
            "default": "2 days ago"
          }, {
            "type": "range",
            "id": "rating",
            "min": 1,
            "max": 5,
            "step": 1,
            "label": "Rating",
            "default": 5
          }, {
            "type": "checkbox",
            "id": "show_verified_badge",
            "label": "Show Verified Badge",
            "default": true
          }, {
            "type": "product",
            "id": "product",
            "label": "Product"
          }

        ]
      }
    ],
    "presets": [
      {
        "name": "Massive Review"
      }
    ]
  }
{% endschema %}